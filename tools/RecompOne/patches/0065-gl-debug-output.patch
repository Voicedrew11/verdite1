diff --git a/tools/RecompOne/RecompOne.Runtime/Host/Window/GlDebug.cs b/tools/RecompOne/RecompOne.Runtime/Host/Window/GlDebug.cs
new file mode 100644
index 0000000..08f0fa9
--- /dev/null
+++ b/tools/RecompOne/RecompOne.Runtime/Host/Window/GlDebug.cs
@@ -0,0 +1,118 @@
+using System.Runtime.InteropServices;
+using Silk.NET.OpenGL;
+using Silk.NET.Windowing;
+
+namespace RecompOne.Runtime.Host.Window;
+
+/// <summary>
+/// 0065. The GL backend checks nothing after a call, so a driver that refuses a
+/// framebuffer or a draw leaves that pass empty and says nothing. KF2_GLDEBUG=1
+/// asks for a debug context and prints what the driver reports; =2 also prints
+/// notifications and the managed stack of each first report, which names the
+/// call. Off, it costs nothing.
+/// </summary>
+internal static class GlDebug
+{
+    public static readonly int Level = Parse(Environment.GetEnvironmentVariable("KF2_GLDEBUG"));
+    public static bool On => Level > 0;
+
+    const int FirstReports = 3;
+
+    static readonly Dictionary<(GLEnum, GLEnum, int), long> _seen = new();
+    static readonly object _lock = new();
+    static DebugProc? _proc;
+    static bool _pollErrors;
+
+    static int Parse(string? v)
+    {
+        if (string.IsNullOrWhiteSpace(v) || v.Trim() == "0") return 0;
+        return int.TryParse(v.Trim(), out var n) && n > 1 ? 2 : 1;
+    }
+
+    public static ContextFlags Flags(ContextFlags flags) => On ? flags | ContextFlags.Debug : flags;
+
+    public static unsafe void Install(GL gl)
+    {
+        if (!On) return;
+
+        int major = gl.GetInteger(GLEnum.MajorVersion), minor = gl.GetInteger(GLEnum.MinorVersion);
+        // A 2.1 context has neither the indexed extension query nor context flags.
+        bool khr = major > 4 || (major == 4 && minor >= 3) || (major >= 3 && HasExtension(gl, "GL_KHR_debug"));
+        bool debugCtx = major >= 3 && (gl.GetInteger(GLEnum.ContextFlags) & (int)GLEnum.ContextFlagDebugBit) != 0;
+
+        if (!khr)
+        {
+            // No callback on this context: read glGetError once a present instead.
+            _pollErrors = true;
+            Console.WriteLine($"[GL] debug: {major}.{minor} has no KHR_debug; polling glGetError each present");
+            return;
+        }
+
+        _proc = OnMessage;
+        gl.Enable(EnableCap.DebugOutput);
+        gl.Enable(EnableCap.DebugOutputSynchronous);
+        gl.DebugMessageCallback(_proc, null);
+        gl.DebugMessageControl(DebugSource.DontCare, DebugType.DontCare,
+            DebugSeverity.DebugSeverityNotification, 0, null, Level > 1);
+        Console.WriteLine($"[GL] debug: callback on, {(debugCtx ? "debug" : "non-debug")} context");
+    }
+
+    public static void Poll(GL? gl)
+    {
+        if (!_pollErrors || gl == null) return;
+        for (int i = 0; i < 8; i++)
+        {
+            var e = gl.GetError();
+            if (e == GLEnum.NoError) return;
+            Report(GLEnum.DebugSourceApi, GLEnum.DebugTypeError, (int)e, GLEnum.DebugSeverityHigh, $"glGetError {e}");
+        }
+    }
+
+    static void OnMessage(GLEnum source, GLEnum type, int id, GLEnum severity, int length, nint message, nint user)
+    {
+        var text = Marshal.PtrToStringUTF8(message, length) ?? "";
+        Report(source, type, id, severity, text);
+    }
+
+    static void Report(GLEnum source, GLEnum type, int id, GLEnum severity, string text)
+    {
+        long n;
+        lock (_lock)
+        {
+            _seen.TryGetValue((source, type, id), out n);
+            _seen[(source, type, id)] = ++n;
+        }
+
+        // A message repeated every frame prints its first few, then at each power of ten.
+        if (n > FirstReports && !IsPowerOfTen(n)) return;
+
+        var line = $"[GL] {Name(severity)} {Name(type)} {Name(source)} #{id}" +
+                   (n > FirstReports ? $" (x{n})" : "") + $": {text.TrimEnd()}";
+        if (Level > 1 && n == 1 && severity != GLEnum.DebugSeverityNotification)
+            line += Environment.NewLine + Environment.StackTrace;
+        Console.Error.WriteLine(line);
+    }
+
+    static bool IsPowerOfTen(long n)
+    {
+        while (n >= 10 && n % 10 == 0) n /= 10;
+        return n == 1;
+    }
+
+    static string Name(GLEnum e)
+    {
+        var s = e.ToString();
+        foreach (var p in (string[])["DebugSeverity", "DebugType", "DebugSource"])
+            if (s.StartsWith(p)) return s[p.Length..].ToLowerInvariant();
+        return s;
+    }
+
+    static bool HasExtension(GL gl, string name)
+    {
+        var count = gl.GetInteger(GLEnum.NumExtensions);
+        for (uint i = 0; i < count; i++)
+            if (gl.GetStringS(StringName.Extensions, i) == name)
+                return true;
+        return false;
+    }
+}
