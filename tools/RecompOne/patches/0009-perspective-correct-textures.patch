diff --git a/RecompOne.Runtime/Gpu/GteDepth.cs b/RecompOne.Runtime/Gpu/GteDepth.cs
new file mode 100644
index 0000000..e99effd
--- /dev/null
+++ b/RecompOne.Runtime/Gpu/GteDepth.cs
@@ -0,0 +1,142 @@
+namespace RecompOne.Runtime;
+
+/// <summary>
+/// Per-vertex view depth, recovered from the GTE and looked up again by screen
+/// position — the one piece of information the GPU never gets, and the reason
+/// PlayStation textures swim.
+///
+/// The GTE does the perspective divide itself: <c>RTPS</c>/<c>RTPT</c> project a
+/// vertex to a 2D screen coordinate and the game copies that coordinate into a
+/// GP0 packet. By the time the GPU sees a polygon there is no depth left in it, so
+/// it can only interpolate U and V linearly across the screen — affine mapping,
+/// which is exact only for a surface parallel to the screen and increasingly wrong
+/// the more a surface is foreshortened. That is the swimming, and the diagonal
+/// crease down a quad where its two triangles disagree.
+///
+/// So the depth has to be caught upstream and carried forward. <c>Gte.Rtp</c> knows
+/// both halves at once — it computes the screen coordinate and the view depth SZ3
+/// in the same call — and the screen coordinate is exactly what turns up in the
+/// packet: <c>SatX</c>/<c>SatY</c> clamp it to 11 bits signed, which is the same
+/// 11 bits <c>GpuRaster.CoordX</c> decodes. That makes the screen position a key
+/// the two ends can share without tracking a single register or store.
+///
+/// Hence a small hash table: the GTE writes (x, y) -> z as it projects, and the
+/// GPU asks for it again as it decodes a vertex word. A hit gives the polygon a W
+/// per vertex and both renderers switch to perspective-correct interpolation; a
+/// miss leaves the vertex exactly as it was. **2D work therefore corrects itself**
+/// — a HUD sprite whose coordinates the CPU computed was never in the table, so it
+/// keeps the affine mapping it wants.
+///
+/// Three properties of the table are deliberate:
+///
+///   * **Nothing is cleared per frame.** Entries carry a monotonic sequence number
+///     and expire once the table's own capacity of vertices has been written past
+///     them, which is a frame or two of geometry. That keeps the frame boundary
+///     out of this file entirely — there is no hook to place and nothing to keep
+///     in step with double buffering.
+///   * **Saturated coordinates are not recorded.** A vertex projecting off screen
+///     clamps to ±1024, so several different vertices at different depths collapse
+///     onto one key. Recording those would hand one of them the other's depth,
+///     which is a worse picture than affine; dropping them just means the polygon
+///     misses and stays as it was.
+///   * **A primitive is all-or-nothing.** The caller only interpolates
+///     perspectively when *every* vertex of the triangle hit, so a polygon can
+///     never mix a real W with a fallback of 1 and shear itself apart.
+/// </summary>
+public static class GteDepth
+{
+    /// <summary>
+    /// While false nothing is recorded and every lookup misses, so both renderers
+    /// take the same path they took before this existed. Safe to change at run
+    /// time: the table simply starts or stops filling.
+    /// </summary>
+    public static bool Enabled;
+
+    const int Bits = 14;
+    const int Size = 1 << Bits;
+    const int Mask = Size - 1;
+
+    // Linear probing, bounded. A key that cannot be placed within this many slots
+    // displaces the oldest of them rather than searching further, so both Record
+    // and TryGet are constant time no matter how full the table is.
+    const int Probe = 8;
+
+    // An entry is stale once a table's worth of vertices has been recorded since.
+    // At a few thousand projected vertices a frame that is the last frame or two.
+    const long MaxAge = Size;
+
+    struct Slot { public int Key; public long Seq; public float Z; }
+
+    static readonly Slot[] _slots = new Slot[Size];
+    static long _seq;
+
+    /// <summary>Vertices recorded, and lookups that found one or did not. The
+    /// hit rate is the only real evidence that the two ends agree on the key.</summary>
+    public static long Recorded, Hits, Misses;
+
+    public static void ResetCounters() => Recorded = Hits = Misses = 0;
+
+    // +1 so that 0 can mean "never written", which is what lets TryGet stop early.
+    static int KeyOf(int x, int y) => (((y & 0x7FF) << 11) | (x & 0x7FF)) + 1;
+
+    static int Bucket(int key) => (int)(((uint)key * 2654435761u) >> (32 - Bits));
+
+    /// <summary>Called from <c>Gte.Rtp</c> with the projected screen position and
+    /// the view depth that produced it. <paramref name="z"/> is SZ3, the same
+    /// quantity the divider used, so it is proportional to view-space W.</summary>
+    public static void Record(int x, int y, int z)
+    {
+        if (!Enabled || z <= 0) return;
+
+        int key = KeyOf(x, y);
+        int bucket = Bucket(key);
+        long now = ++_seq;
+
+        int oldest = bucket;
+        long oldestSeq = long.MaxValue;
+
+        for (int i = 0; i < Probe; i++)
+        {
+            int s = (bucket + i) & Mask;
+            ref var slot = ref _slots[s];
+            if (slot.Key == key || slot.Key == 0 || now - slot.Seq > MaxAge)
+            {
+                slot.Key = key;
+                slot.Seq = now;
+                slot.Z = z;
+                Recorded++;
+                return;
+            }
+            if (slot.Seq < oldestSeq) { oldestSeq = slot.Seq; oldest = s; }
+        }
+
+        _slots[oldest] = new Slot { Key = key, Seq = now, Z = z };
+        Recorded++;
+    }
+
+    /// <summary>The depth last projected to this screen position, if it is recent
+    /// enough to belong to the geometry being drawn now.</summary>
+    public static bool TryGet(int x, int y, out float z)
+    {
+        z = 0f;
+        if (!Enabled) return false;
+
+        int key = KeyOf(x, y);
+        int bucket = Bucket(key);
+        long now = _seq;
+
+        for (int i = 0; i < Probe; i++)
+        {
+            ref var slot = ref _slots[(bucket + i) & Mask];
+            if (slot.Key == 0) break;          // insertion would have stopped here too
+            if (slot.Key != key) continue;
+            if (now - slot.Seq > MaxAge) break;
+            z = slot.Z;
+            Hits++;
+            return true;
+        }
+
+        Misses++;
+        return false;
+    }
+}
