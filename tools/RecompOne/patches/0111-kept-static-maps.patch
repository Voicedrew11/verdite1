+    sealed class KeptStatic
+    {
+        public ulong Key;
+        public int Generation, Count;
+        public long Used;
+        public Vertex[] Verts = [];
+        public object? Tag;
+        public int[] Start = [], CountOf = [], RangeStart = [], RangeCount = [];
+        public float[] Min = [], Max = [], BlendMin = [], BlendMax = [], PlainQ = [];
