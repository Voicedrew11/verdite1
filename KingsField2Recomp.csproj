<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>KingsField2</AssemblyName>
        <RootNamespace>KingsField2</RootNamespace>
        <ApplicationIcon>packaging/shared/verdite2.ico</ApplicationIcon>
        <!--
          QuickJit off: every method with no precompiled code is JIT-compiled once,
          fully optimised, and never tiered up. Tier-up recompiles a method, and
          MonoMod's detour does not reliably follow it to the new code, so a hook
          that committed stops firing for the rest of the session, measured 1 boot
          in 10 losing FramePacing's VSync or DrawOTag detour (6 in 10 with tier-up
          forced early), and 0 in 10 with this off. Costs about 2 s to the first
          area and a few seconds of first-run dips. Verdite2.Launcher.csproj runs the
          game in its own process and must carry the same property. See "The
          smoothing is sometimes dead for a whole session" in docs/TODO.md.
        -->
        <TieredCompilationQuickJit>false</TieredCompilationQuickJit>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="tools/RecompOne/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    </ItemGroup>

    <!--
      The recompiler emits C# into generated/, and hand-written function
      replacements live in patches/. Both sit under the project root, so the
      SDK's default item globs pick them up automatically. Adding an explicit
      Compile Include for them causes NETSDK1022 (duplicate Compile items).

      That same default glob is why tools/ must be removed explicitly: the
      RecompOne checkout is nested inside this project directory, so without
      this the build would compile RecompOne's own sources and the AssemblyInfo
      files under its obj/, producing CS0579 duplicate-attribute errors.
      RecompOne.Runtime is consumed through the ProjectReference above instead.
    -->
    <ItemGroup>
        <Compile Remove="tools/**" />
        <EmbeddedResource Remove="tools/**" />
        <None Remove="tools/**" />
    </ItemGroup>

    <!--
      mods/ is RecompOne's ModLoader root, not project source. Its .cs files are
      read from disk and compiled by Roslyn at run time, so the default glob must
      not also compile them into this assembly: that would produce a second, inert
      copy of every mod type and let the two drift apart.

      Anything that must always be on does NOT belong here. It goes in patches/
      and attaches through HookManager; patches/FramePacing.cs is the example.
    -->
    <ItemGroup>
        <Compile Remove="mods/**" />
        <EmbeddedResource Remove="mods/**" />
        <None Remove="mods/**" />
    </ItemGroup>

    <!--
      mcp/ is a separate program (an MCP server for agent hosts), not part of the
      game assembly. Nested under this directory its sources and obj/ AssemblyInfo
      would be picked up by the default globs — the CS0579 trap tools/** and
      mods/** are already removed for.
    -->
    <ItemGroup>
        <Compile Remove="mcp/**" />
        <EmbeddedResource Remove="mcp/**" />
        <None Remove="mcp/**" />
    </ItemGroup>

    <!--
      Verdite2.Launcher/ is the shipped executable and the opposite kind of project
      to this one: it must build WITHOUT the disc, so it compiles none of
      generated/ and none of patches/ (it carries them as payload and compiles
      them at first run instead). Nested here its sources would be swept into this
      assembly by the default glob, along with the CS0579 duplicate attributes from
      its obj/, which is the same trap tools/**, mods/** and mcp/** are removed for.
    -->
    <ItemGroup>
        <Compile Remove="Verdite2.Launcher/**" />
        <EmbeddedResource Remove="Verdite2.Launcher/**" />
        <None Remove="Verdite2.Launcher/**" />
    </ItemGroup>

    <!--
      dist/ is where the packaging stages a release, and a staged release contains
      a COPY of Program.cs and patches/** under content/src. The default glob picks
      those up as a second definition of every type in patches/, so the developer
      build stops compiling the moment anyone has run build-appimage.sh or
      build-windows.ps1: 1412 CS0101/CS0111 errors, and none of them in a file
      anybody edited. It is gitignored, so this never shows up in a fresh clone.
    -->
    <ItemGroup>
        <Compile Remove="dist/**" />
        <EmbeddedResource Remove="dist/**" />
        <None Remove="dist/**" />
    </ItemGroup>

    <!--
      packaging/windows/Stub/ is a nested net48 project. Building it (the Windows
      package script does) leaves AssemblyInfo.cs under its obj/, and the default
      glob compiles that into this assembly — CS0579, the same trap tools/**,
      mcp/** and Verdite2.Launcher/** are removed for. Its Program.cs would also
      become a second Main. The rest of packaging/ is scripts and icons, so the
      remove is the whole tree.
    -->
    <!--
      reference/ holds what this repository carried over from the King's Field II
      port that the King's Field build does not compile: KF2's Program.cs above
      all, which would be a second set of top-level statements. See docs/KF1.md.
    -->
    <ItemGroup>
        <Compile Remove="reference/**" />
        <EmbeddedResource Remove="reference/**" />
        <None Remove="reference/**" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="packaging/**" />
        <EmbeddedResource Remove="packaging/**" />
        <None Remove="packaging/**" />
    </ItemGroup>

</Project>
