+// PC extension (fog drawn per pixel): as above, with each colour also before the
+// depth cue. The projected corners carry the cue doubled (p2 = fog << shift),
+// which is the scale unless the writer cued by another.
+inline void render_face_submit(kf::DrawFace *face, std::span<const kf::DepthCuedColor> colors,
+    kf::FaceShading shading, s32 depth, float depth_cue_scale = 1 << KF_TMD_DEFAULT_PERSPECTIVE_SHIFT)
+{
+    const float divisor = face->material.kind == kf::SurfaceKind::Texture ? kf::texture_color_unity : kf::color8_scale;
+    for (std::size_t i = 0; i < static_cast<unsigned>(face->shape); ++i) {
+        const auto &clear = colors[shading == kf::FaceShading::Flat ? 0 : i].clear;
+        face->vertices[i].clear_r = clear.r / divisor;
+        face->vertices[i].clear_g = clear.g / divisor;
+        face->vertices[i].clear_b = clear.b / divisor;
+    }
+    std::array<CVECTOR, 4> cued {};
+    const std::size_t count = std::min(colors.size(), cued.size());
+    for (std::size_t i = 0; i < count; ++i)
+        cued[i] = colors[i].cued;
+    face->depth_cue_scale = depth_cue_scale;
+    render_face_submit(face, std::span<const CVECTOR>(cued.data(), count), shading, depth);
+}
