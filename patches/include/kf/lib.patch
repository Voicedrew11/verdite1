+        const SVECTOR normal = tmd_read_normal(normals, p.normals[shading == kf::FaceShading::Flat ? 0 : i]);
+        face.vertices[i].nx = normal.vx;
+        face.vertices[i].ny = normal.vy;
+        face.vertices[i].nz = normal.vz;
+    }
+}
