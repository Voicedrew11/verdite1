+    s32 u, v;
+};
+std::vector<MenuTextQuad> menu_text_quads(std::span<const MenuTextGlyph> glyphs);
+// PC extension: text spelled onto the end of a line, so a space it starts with moves on from the
+// line's last glyph (menu_spell alone has none to move on from, and drops it).
+void menu_spell_onto(std::vector<MenuTextGlyph> &line, std::string_view text, kf::Language language);
+// PC extension: an extra item's name, its capitals in the Little lettering of the disc's own item
