+    s16 advance;   // pixels to the next glyph
+    s16 u = 0;     // Little only: the piece of the font page to draw
+    s16 v = 0;
+    s16 width = 0;
+    s16 height = 0;
+    s16 y = 0;     // Little only: pixels below the line's top
+};
+
