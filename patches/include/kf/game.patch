+// PC extension: free text in the menu font, for the port's SETTINGS page. The
+// label font holds English's individual capitals or Japanese's kana (without
+// small kana or を), not both; digits and '/' come from the number font in
+// either. In Japanese, capitals come from the English font (menu_latin_font)
+// while its files are there. Characters no font has are left out.
+//
+// Little is the thin lettering the disc's item names are made of. The English font page has it only
+// inside its word pieces, so a Little glyph names a place on the page rather than a cell, and is
+// drawn from the English font in either language.
+enum class MenuTextFont : u8 { Label, Number, Latin, Little };
+
+struct MenuTextGlyph {
+    MenuTextFont font;
+    s16 code;      // as MenuGlyphRow and menu_draw_number take it, dakuten bits included
