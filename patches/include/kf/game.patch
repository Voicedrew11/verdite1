diff --git a/include/kf/game/menu_text.h b/include/kf/game/menu_text.h
index 87ebaf4e17ad51009ffb9735cd87841961d6765f..af66c0d59f86e2537787f1f3aaabad037c3fb4b3 100644
--- a/include/kf/game/menu_text.h
+++ b/include/kf/game/menu_text.h
@@ -5,6 +5,10 @@
 #include <kf/game/resources.h>
 #include <kf/platform/language.h>
 
+#include <span>
+#include <string_view>
+#include <vector>
+
 // Authored atlas glyphs, not Unicode. Resource-owned rows still come from STAT.DAT.
 // English v1.0's executable edits are recorded in docs/english-resources.md.
 enum class MenuLabel {
@@ -27,17 +31,17 @@ inline MenuGlyphRow menu_label(MenuLabel label)
     switch (label) {
     case MenuLabel::Language:
         // The translation's individual capitals also spell BACK and COMPASS.
-        // Japanese uses the original kana: げんご.
+        // Japanese uses the original kana (hiragana n is glyph 0x67): げんご.
         return english ? MenuGlyphRow{{0x136, 0xdc, 0x50, 0x146, 0x11, 0xdc, 0x146, 0x138, MENU_TEXT_END}}
-                       : MenuGlyphRow{{MENU_TEXT_DAKUTEN | 0x48, 0x6d, MENU_TEXT_DAKUTEN | 0x49, MENU_TEXT_END}};
+                       : MenuGlyphRow{{MENU_TEXT_DAKUTEN | 0x48, 0x67, MENU_TEXT_DAKUTEN | 0x49, MENU_TEXT_END}};
     case MenuLabel::LanguageName:
         // ENGLISH / にほんご.
         return english ? MenuGlyphRow{{0x138, 0x50, 0x146, 0x136, 0x4, 0x134, 0x3, MENU_TEXT_END}}
-                       : MenuGlyphRow{{0x55, 0x5d, 0x6d, MENU_TEXT_DAKUTEN | 0x49, MENU_TEXT_END}};
+                       : MenuGlyphRow{{0x55, 0x5d, 0x67, MENU_TEXT_DAKUTEN | 0x49, MENU_TEXT_END}};
     case MenuLabel::LanguageUnavailable:
         // NO DATA / つかえません.
         return english ? MenuGlyphRow{{0x50, 0x0, MENU_TEXT_BLANK, 0xb, 0xdc, 0x10, 0xdc, MENU_TEXT_END}}
-                       : MenuGlyphRow{{0x51, 0x45, 0x43, 0x5e, 0x4d, 0x6d, MENU_TEXT_END}};
+                       : MenuGlyphRow{{0x51, 0x45, 0x43, 0x5e, 0x4d, 0x67, MENU_TEXT_END}};
     case MenuLabel::Pickup:
         return english ? MenuGlyphRow{{0x00, 0x06, MENU_TEXT_END}}
                        : MenuGlyphRow{{0x53, 0x6a, MENU_TEXT_END}};
@@ -123,4 +127,20 @@ inline MenuGlyphRow menu_label(MenuLabel label)
     return {{MENU_TEXT_END}};
 }
 
+// PC extension: free text in the menu font, for the port's SETTINGS page. The
+// label font holds English's individual capitals or Japanese's kana (without
+// small kana or を), not both; digits and '/' come from the number font in
+// either. Characters the language's font lacks are left out.
+enum class MenuTextFont : u8 { Label, Number };
+
+struct MenuTextGlyph {
+    MenuTextFont font;
+    s16 code;      // as MenuGlyphRow and menu_draw_number take it, dakuten bits included
+    s16 left;      // blank columns at the cell's left, skipped
+    s16 advance;   // pixels to the next glyph
+};
+
+std::vector<MenuTextGlyph> menu_spell(std::string_view text, kf::Language language);
+s32 menu_text_width(std::span<const MenuTextGlyph> glyphs);
+
 #endif // KF_GAME_MENU_TEXT_H
