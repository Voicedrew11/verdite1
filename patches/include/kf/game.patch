+void menu_spell_item_name_onto(std::vector<MenuTextGlyph> &line, std::string_view name, kf::Language language);
+s32 menu_text_width(std::span<const MenuTextGlyph> glyphs);
+
 #endif // KF_GAME_MENU_TEXT_H
