+void tmd_carry_projected(std::span<KfScreenVertex> projected, std::span<const SVECTOR> vertices,
+    const MATRIX &model)
+{
+    for (auto &vertex : projected) {
+        vertex.part = 0;
+        vertex.bx = vertex.by = vertex.bz = 0;
+    }
+    if (kf::render_entity_tag == 0 || projected.empty() || vertices.size() < projected.size())
+        return;
+    if (kf::render_camera_fixed || projected[0].w == 0.0f) {
+        std::vector<std::array<float, 2>> points(projected.size());
+        for (std::size_t i = 0; i < projected.size(); ++i) {
+            points[i] = kf::render_subpixel
+                ? std::array<float, 2>{projected[i].fx, projected[i].fy}
+                : std::array<float, 2>{float(projected[i].position.vx), float(projected[i].position.vy)};
+        }
+        const auto back = kf::host_carry_screen(points);
+        for (std::size_t i = 0; i < back.size() && i < projected.size(); ++i) {
+            projected[i].bx = back[i][0];
+            projected[i].by = back[i][1];
+        }
+        return;
+    }
+    const kf::CarriedModel carried = kf::host_carry_model(model, vertices.first(projected.size()));
+    for (std::size_t i = 0; i < carried.back.size() && i < projected.size(); ++i) {
+        projected[i].part = carried.part;
+        projected[i].lx = vertices[i].vx;
+        projected[i].ly = vertices[i].vy;
+        projected[i].lz = vertices[i].vz;
+        projected[i].bx = carried.back[i][0];
+        projected[i].by = carried.back[i][1];
+        projected[i].bz = carried.back[i][2];
+    }
+}
