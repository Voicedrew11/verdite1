+
+void render_carry_screen_face(kf::DrawFace &face)
+{
+    if (kf::render_entity_tag == 0)
+        return;
+    const auto count = static_cast<std::size_t>(face.shape);
+    std::array<std::array<float, 2>, 4> points {};
+    for (std::size_t i = 0; i < count; ++i)
+        points[i] = {face.vertices[i].x, face.vertices[i].y};
+    const auto back = kf::host_carry_screen(std::span(points).first(count));
+    for (std::size_t i = 0; i < back.size() && i < count; ++i) {
+        face.vertices[i].bx = back[i][0];
+        face.vertices[i].by = back[i][1];
+    }
+}
+
+void render_carry_sprite(kf::DrawFace &face, std::span<const SVECTOR, 4> corners, const MATRIX &model)
+{
+    if (kf::render_entity_tag == 0)
+        return;
+    if (kf::render_camera_fixed) {
+        render_carry_screen_face(face);
+        return;
+    }
+    // A corner behind the camera is drawn camera-fixed (cz = 0) and cannot move with the rest.
+    for (const auto &vertex : face.vertices)
+        if (vertex.cz <= 0.0f)
+            return;
+    const kf::CarriedModel carried = kf::host_carry_model(model, corners);
+    for (std::size_t i = 0; i < carried.back.size() && i < corners.size(); ++i) {
+        auto &out = face.vertices[i];
+        out.lx = corners[i].vx;
+        out.ly = corners[i].vy;
+        out.lz = corners[i].vz;
+        out.bx = carried.back[i][0];
+        out.by = carried.back[i][1];
+        out.bz = carried.back[i][2];
+        face.part = carried.part;
+    }
+}
