+// PC extension: the title menu over the logo (kf/platform/title.h), in the menu's font, boxes and
+// cursor, until the player chooses how to start, F4 quick loads, or the top page is left idle as
+// long as the logo held before. NEW GAME is ADVANCE, as a button at the logo was; CONTINUE and
+// CO-OP are SKIP.
+static KfOpeningInputAction opening_scene1_title_menu(void)
+{
+    if (!menu_title_prepare()) {
+        std::printf("The title menu's font could not be loaded; any button starts a new game.\n");
+        return KF_OPENING_INPUT_ADVANCE;
+    }
+    kf::title_open();
+    const auto previous_context = kf::host_set_input_context(kf::InputContext::Menu);
+    kf::host_wait_buttons_released();
+    KfOpeningInputAction action = KF_OPENING_INPUT_NONE;
+    u32 input = 0;
+    s32 idle_frames = 0;
+    for (;;) {
+        if (idle_frames == SCENE1_SEQUENCE_STOP_FRAME) {
+            audio_stop_sequence(KF_AUDIO_STOP_IMMEDIATE);
+        }
+        const u32 previous_input = input;
+        input = kf::host_read_buttons();
+        const u32 pressed = input & ~previous_input;
+        if (kf::host_opening_quick_load()) {
+            action = KF_OPENING_INPUT_QUICK_LOAD;
+            break;
+        }
+        if (const auto start = kf::title_update(pressed)) {
+            action = *start == kf::TitleStart::NewGame ? KF_OPENING_INPUT_ADVANCE : KF_OPENING_INPUT_SKIP;
+            break;
+        }
+        display_begin_frame(open_graphics_runtime.display_state);
+        const bool top_page = menu_title_draw();
+        opening_scene1_submit_logo(top_page ? KF_TEXTURE_BASE_BRIGHTNESS : KF_TEXTURE_BASE_BRIGHTNESS / 3,
+            MENU_BACKGROUND_OT_DEPTH);
+        display_present_frame(open_graphics_runtime.display_state);
+        idle_frames = pressed != 0 ? 0 : idle_frames + 1;
+        if (top_page && idle_frames >= SCENE1_HOLD_FRAMES) {
+            break;
+        }
+    }
+    kf::host_set_input_context(previous_context);
+    kf::host_wait_buttons_released();
+    return action;
+}
