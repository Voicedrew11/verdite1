+        y += feed_row_step;
+    }
+    // A player who is down: whose eyes it sees through, low in the middle of the picture.
+    constexpr s16 watching_y = 200, picture_middle_x = 160;
+    const auto watching = menu_spell(kf::coop_watching_text(language), language);
+    if (!watching.empty()) {
+        const s32 width = static_cast<s32>(watching.size()) * MENU_FONT_CELL_WIDTH;
+        menu_draw_text(watching, MenuPoint{static_cast<s16>(picture_middle_x - width / 2), watching_y}, 1.0f, MENU_HUD_OT_DEPTH);
