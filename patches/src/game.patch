+// The individual capitals A to Z in the English label font: the cell, the blank
+// columns at its left and the width of the letter, measured off COM/MIX.TIM.
+struct Capital {
+    s16 code;
+    s16 left;
+    s16 width;
+};
+constexpr std::array<Capital, 26> english_capitals = {{
+    {0xdc, 3, 9}, {0xdf, 4, 7}, {0x135, 3, 8}, {0x0b, 4, 7}, {0x138, 4, 6}, {0x02, 4, 6}, {0x146, 3, 8},
+    {0x03, 3, 7}, {0x04, 6, 2}, {0x05, 3, 6}, {0x06, 3, 7}, {0x136, 4, 6}, {0x0a, 2, 9}, {0x50, 3, 7},
+    {0x00, 3, 8}, {0x140, 4, 7}, {0x29, 3, 8}, {0x2c, 3, 8}, {0x134, 4, 7}, {0x10, 3, 10}, {0x11, 3, 7},
+    {0x137, 2, 9}, {0x08, 0, 13}, {0xc9, 3, 7}, {0x2f, 3, 8}, {0x12, 3, 7},
+}};
+
+// The Japanese label font's kana run in this order, hiragana from 0x40 and
+// katakana from 0x00; ー follows the katakana.
+constexpr std::u32string_view hiragana = U"あいうえおかきくけこさしすせそたちつてとなにぬねのはひふへほまみむめもやゆよわんらりるれろ";
+constexpr std::u32string_view katakana = U"アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨワンラリルレロ";
+constexpr s16 hiragana_first = 0x40;
+constexpr s16 katakana_first = 0x00;
+constexpr s16 long_vowel = 0x2d;
+constexpr std::u32string_view voiced = U"がぎぐげござじずぜぞだぢづでどばびぶべぼガギグゲゴザジズゼゾダヂヅデドバビブベボヴ";
+constexpr std::u32string_view voiced_base = U"かきくけこさしすせそたちつてとはひふへほカキクケコサシスセソタチツテトハヒフヘホウ";
+constexpr std::u32string_view half_voiced = U"ぱぴぷぺぽパピプペポ";
+constexpr std::u32string_view half_voiced_base = U"はひふへほハヒフヘホ";
+
+constexpr s16 letter_gap = 2;
+constexpr s16 kana_advance = 13;
+constexpr s16 space_advance = 5;
+constexpr s16 number_slash = 11;
+
+std::u32string decode_utf8(std::string_view text)
+{
+    std::u32string out;
+    for (std::size_t i = 0; i < text.size();) {
+        const auto lead = static_cast<unsigned char>(text[i]);
+        const std::size_t length = lead < 0x80 ? 1 : (lead >> 5) == 0x6 ? 2 : (lead >> 4) == 0xe ? 3 : (lead >> 3) == 0x1e ? 4 : 0;
+        if (length == 0 || i + length > text.size()) {
+            i++;
+            continue;
+        }
+        char32_t c = length == 1 ? lead : lead & (0x7f >> length);
+        for (std::size_t k = 1; k < length; k++)
+            c = (c << 6) | (static_cast<unsigned char>(text[i + k]) & 0x3f);
+        out.push_back(c);
+        i += length;
+    }
+    return out;
+}
+
+std::optional<s16> kana_code(char32_t c)
+{
+    if (const auto at = hiragana.find(c); at != std::u32string_view::npos)
+        return static_cast<s16>(hiragana_first + at);
+    if (const auto at = katakana.find(c); at != std::u32string_view::npos)
+        return static_cast<s16>(katakana_first + at);
+    if (c == U'ー')
+        return long_vowel;
+    if (const auto at = voiced.find(c); at != std::u32string_view::npos)
+        if (const auto base = kana_code(voiced_base[at]))
+            return static_cast<s16>(*base | MENU_TEXT_DAKUTEN);
+    if (const auto at = half_voiced.find(c); at != std::u32string_view::npos)
+        if (const auto base = kana_code(half_voiced_base[at]))
+            return static_cast<s16>(*base | MENU_TEXT_HANDAKUTEN);
+    return std::nullopt;
+}
+
+std::optional<MenuTextGlyph> spell_one(char32_t c, kf::Language language)
+{
+    if (c == U' ')
+        return MenuTextGlyph{MenuTextFont::Label, MENU_TEXT_BLANK, 0, space_advance};
+    if (c >= U'0' && c <= U'9')
+        return MenuTextGlyph{MenuTextFont::Number, static_cast<s16>(c - U'0'), 0, MENU_NUMBER_ADVANCE};
+    if (c == U'/')
+        return MenuTextGlyph{MenuTextFont::Number, number_slash, 0, MENU_NUMBER_ADVANCE};
+    if (c >= U'A' && c <= U'Z') {
+        const bool english = language == kf::Language::English;
+        if (!english && !menu_latin_font())
+            return std::nullopt;
+        const Capital &capital = english_capitals[c - U'A'];
+        return MenuTextGlyph{english ? MenuTextFont::Label : MenuTextFont::Latin, capital.code, capital.left,
+            static_cast<s16>(capital.width + letter_gap)};
+    }
+    if (language == kf::Language::English)
+        return std::nullopt;
+    if (const auto code = kana_code(c))
+        return MenuTextGlyph{MenuTextFont::Label, *code, 0, kana_advance};
+    return std::nullopt;
+}
+
+} // namespace
+
+std::vector<MenuTextGlyph> menu_spell(std::string_view text, kf::Language language)
+{
+    std::vector<MenuTextGlyph> glyphs;
+    menu_spell_onto(glyphs, text, language);
+    return glyphs;
+}
+
+void menu_spell_onto(std::vector<MenuTextGlyph> &glyphs, std::string_view text, kf::Language language)
+{
+    for (const char32_t c : decode_utf8(text)) {
+        const auto glyph = spell_one(c, language);
+        if (!glyph)
+            continue;
+        if (glyph->code == MENU_TEXT_BLANK) {
+            // A space only moves on: the label font's blank cell is not empty in every language.
+            if (!glyphs.empty())
+                glyphs.back().advance += glyph->advance;
+            continue;
+        }
+        glyphs.push_back(*glyph);
+    }
+}
+
+s32 menu_text_width(std::span<const MenuTextGlyph> glyphs)
+{
+    s32 width = 0;
+    for (const MenuTextGlyph &glyph : glyphs)
+        width += glyph.advance;
+    return glyphs.empty() ? 0 : width - letter_gap;
+}
+
+namespace {
+
+// The CONFIG panel's places: its title, rows and option boxes.
+enum {
+    SETTINGS_TITLE_X = 12,
+    SETTINGS_TITLE_Y = 19,
+    SETTINGS_ROW_X = 26,
+    SETTINGS_FIRST_ROW_Y = 41,
+    SETTINGS_ROW_STEP = 22,
+    SETTINGS_VALUE_X = 180,
+    SETTINGS_VALUE_WIDTH = 110,
+    SETTINGS_TEXT_INSET = 6,
+    // A translucent box sprite sits this far up and left of its text's place.
+    SETTINGS_BOX_X_OFFSET = 4,
+    SETTINGS_BOX_Y_OFFSET = 3
+};
+
+constexpr float settings_dim_shade = 0.45f;
+
+struct SettingsRowText {
+    std::string label;
+    std::string value;
+    bool enabled = true;
+};
+
+void settings_draw_centred(const std::vector<MenuTextGlyph> &glyphs, s32 x, s32 width, s32 y, float shade)
+{
+    const s32 left = x - SETTINGS_BOX_X_OFFSET + (width - menu_text_width(glyphs)) / 2;
+    menu_draw_text(glyphs, MenuPoint{static_cast<s16>(left), static_cast<s16>(y)}, shade);
+}
+
+// The title with the page number in its box, then the rows: each label in a row
+// box, its value in an option box, lit on the cursor's row.
+void settings_draw(const std::string &title, s32 page_number, s32 page_count,
+    const std::vector<SettingsRowText> &rows, s32 selected_row, kf::Language language)
+{
+    const auto &assets = menu_resources().assets;
+    const s32 box_width = assets.row_background.width;
+    const MenuPoint title_at{SETTINGS_TITLE_X, SETTINGS_TITLE_Y};
+    menu_blit_sprite_translucent(&assets.row_background, &title_at);
+    menu_draw_text(menu_spell(title, language), MenuPoint{SETTINGS_TITLE_X + SETTINGS_TEXT_INSET - SETTINGS_BOX_X_OFFSET, SETTINGS_TITLE_Y}, 1.0f);
+    if (page_count > 1) {
+        const auto pages = menu_spell(std::to_string(page_number) + "/" + std::to_string(page_count), language);
+        const s32 right = SETTINGS_TITLE_X - SETTINGS_BOX_X_OFFSET + box_width - SETTINGS_TEXT_INSET;
+        menu_draw_text(pages, MenuPoint{static_cast<s16>(right - menu_text_width(pages)), SETTINGS_TITLE_Y}, 1.0f);
+    }
+
+    kf::host_menu_widget(kf::MenuWidget::Window, selected_row);
+    for (s32 i = 0; i < static_cast<s32>(rows.size()); i++) {
+        const MenuPoint at{SETTINGS_ROW_X, static_cast<s16>(SETTINGS_FIRST_ROW_Y + i * SETTINGS_ROW_STEP)};
+        const auto label = menu_spell(rows[i].label, language);
+        const s32 label_width = std::max(box_width, menu_text_width(label) + 2 * SETTINGS_TEXT_INSET);
+        const bool held = kf::host_menu_row(i, at.x - SETTINGS_BOX_X_OFFSET,
+            at.y - SETTINGS_BOX_Y_OFFSET, SETTINGS_VALUE_X + SETTINGS_VALUE_WIDTH - at.x,
+            assets.row_background.height);
+        menu_blit_box_translucent(held ? assets.row_confirmed_background : assets.row_background, at, label_width);
+        if (i == selected_row)
+            menu_blit_sprite(&assets.selection_cursor, &at);
+        const float shade = rows[i].enabled ? 1.0f : settings_dim_shade;
+        menu_draw_text(label, MenuPoint{static_cast<s16>(at.x + SETTINGS_TEXT_INSET - SETTINGS_BOX_X_OFFSET), at.y}, shade);
+        if (rows[i].value.empty())
+            continue;
+        const MenuPoint value_at{SETTINGS_VALUE_X, at.y};
+        menu_blit_box_translucent(i == selected_row ? assets.option_highlight : assets.option_background,
+            value_at, SETTINGS_VALUE_WIDTH);
+        settings_draw_centred(menu_spell(rows[i].value, language), SETTINGS_VALUE_X, SETTINGS_VALUE_WIDTH,
+            at.y, shade);
+    }
+    menu_enqueue_background();
+}
+
+void settings_draw_page(kf::Language language)
+{
+    const kf::SettingsPageView view = kf::settings_page_view(language);
+    std::vector<SettingsRowText> rows;
+    s32 selected = 0;
+    for (const auto &row : view.rows) {
+        if (row.selected)
+            selected = static_cast<s32>(rows.size());
+        rows.push_back({row.label, row.value, row.enabled});
+    }
+    settings_draw(view.title, view.page_number, view.page_count, rows, selected, language);
+}
+
+// The question on leaving with changes: 0 saves, 1 discards.
+void settings_draw_question(s32 answer, kf::Language language)
+{
+    const kf::SettingsPageView view = kf::settings_page_view(language);
+    settings_draw(view.title, view.page_number, view.page_count,
+        {{kf::settings_page_save_text(language), {}, true}, {kf::settings_page_discard_text(language), {}, true}},
+        answer, language);
+}
+
+enum class SettingsLeave : u8 { Stay, Leave };
+
+// One pad read on the page. Leave once nothing is left to ask.
+SettingsLeave settings_page_input(u32 input, u32 prev, bool *asking)
+{
+    if (kf::button_pressed(input, prev, kf::Button::Up)) {
+        menu_play_input_sound(MENU_SOUND_CURSOR);
+        kf::settings_page_move_row(-1);
+    } else if (kf::button_pressed(input, prev, kf::Button::Down)) {
+        menu_play_input_sound(MENU_SOUND_CURSOR);
+        kf::settings_page_move_row(1);
+    } else if (kf::button_pressed(input, prev, kf::Button::StrafeLeft)) {
+        menu_play_input_sound(MENU_SOUND_CURSOR);
+        kf::settings_page_move_page(-1);
+    } else if (kf::button_pressed(input, prev, kf::Button::StrafeRight)) {
+        menu_play_input_sound(MENU_SOUND_CURSOR);
+        kf::settings_page_move_page(1);
+    } else if (kf::button_pressed(input, prev, kf::Button::Left) || kf::button_pressed(input, prev, kf::Button::Right)
+               || kf::button_pressed(input, prev, kf::Button::Confirm)) {
+        const s32 delta = kf::button_pressed(input, prev, kf::Button::Left) ? -1 : 1;
+        menu_play_input_sound(kf::settings_page_step(delta) ? MENU_SOUND_CONFIRM : MENU_SOUND_CANCEL_OR_ERROR);
+    } else if (kf::button_pressed(input, prev, kf::Button::Back)) {
+        menu_play_input_sound(MENU_SOUND_CANCEL_OR_ERROR);
+        if (!kf::settings_page_changed())
+            return SettingsLeave::Leave;
+        *asking = true;
+    } else if (const auto pointed = kf::host_menu_pointed_row(kf::MenuWidget::Window)) {
+        menu_play_input_sound(MENU_SOUND_CURSOR);
+        kf::settings_page_select_row(*pointed);
+    }
+    return SettingsLeave::Stay;
+}
+
+SettingsLeave settings_question_input(u32 input, u32 prev, s32 *answer, bool *asking)
+{
+    if (kf::button_pressed(input, prev, kf::Button::Up) || kf::button_pressed(input, prev, kf::Button::Down)) {
+        menu_play_input_sound(MENU_SOUND_CURSOR);
+        *answer = 1 - *answer;
+    } else if (kf::button_pressed(input, prev, kf::Button::Confirm)) {
+        menu_play_input_sound(MENU_SOUND_CONFIRM);
+        if (*answer == 0)
+            kf::settings_page_save();
+        else
+            kf::settings_page_discard();
+        return SettingsLeave::Leave;
+    } else if (kf::button_pressed(input, prev, kf::Button::Back)) {
+        menu_play_input_sound(MENU_SOUND_CANCEL_OR_ERROR);
+        *asking = false;
+    } else if (const auto pointed = kf::host_menu_pointed_row(kf::MenuWidget::Window)) {
+        menu_play_input_sound(MENU_SOUND_CURSOR);
+        *answer = *pointed;
+    }
+    return SettingsLeave::Stay;
+}
+
+} // namespace
+
+void menu_settings_panel(void)
+{
+    bool asking = false;
+    s32 answer = 0;
+    u32 input = 0;
+    u32 prev;
+
+    kf::settings_page_open();
+    kf::host_wait_buttons_released();
+    for (;;) {
+        const kf::Language language = game_text_language();
+        menu_frame_begin();
+        prev = input;
+        input = kf::host_read_buttons();
+        const SettingsLeave leave = asking ? settings_question_input(input, prev, &answer, &asking)
+                                           : settings_page_input(input, prev, &asking);
+        if (!asking)
+            answer = 0;
+        if (asking)
+            settings_draw_question(answer, language);
+        else
+            settings_draw_page(language);
+        menu_present_frame();
+        if (leave == SettingsLeave::Leave)
+            break;
+    }
+    kf::host_wait_buttons_released();
+}
diff --git a/src/game/menu_title.cpp b/src/game/menu_title.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3477b71c3ce52813dacbf961e02532772e26f416
--- /dev/null
+++ b/src/game/menu_title.cpp
@@ -0,0 +1,160 @@
+// PC extension: the title menu (kf/platform/title.h) over the opening's logo, drawn with the
+// menu's own boxes, cursor and font as the port's SETTINGS page is. The top page is a short column
+// under the logo; the others fill the picture as the menu's pages do, over the logo dimmed.
+#include <kf/platform/prelude.h>
+#include <kf/game/menu.h>
+#include <kf/game/menu_text.h>
+#include <kf/game/resources.h>
+#include <kf/platform/menu_pointer.h>
+#include <kf/platform/title.h>
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+namespace {
+
+enum {
+    TITLE_SCREEN_WIDTH = 320,
+    TITLE_TOP_FIRST_ROW_Y = 150,
+    TITLE_HEADING_X = 12,
+    TITLE_HEADING_Y = 19,
+    TITLE_ROW_X = 26,
+    TITLE_FIRST_ROW_Y = 41,
+    TITLE_ROW_STEP = 22,
+    TITLE_VISIBLE_ROWS = 7,
+    TITLE_VALUE_X = 180,
+    TITLE_VALUE_WIDTH = 110,
+    TITLE_CODE_WIDTH = 110,
+    TITLE_GRID_CELL_WIDTH = 28,
+    TITLE_GRID_CELL_STEP = 34,
+    TITLE_GRID_CELL_GAP = 4,
+    TITLE_NOTE_Y = 206,
+    TITLE_TEXT_INSET = 6,
+    // A translucent box sprite sits this far up and left of its text's place.
+    TITLE_BOX_X_OFFSET = 4,
+    TITLE_BOX_Y_OFFSET = 3
+};
+
+constexpr float title_dim_shade = 0.45f;
+
+s16 at_x(s32 x)
+{
+    return static_cast<s16>(x);
+}
+
+void title_draw_centred(const std::vector<MenuTextGlyph> &glyphs, s32 x, s32 width, s32 y, float shade)
+{
+    const s32 left = x - TITLE_BOX_X_OFFSET + (width - menu_text_width(glyphs)) / 2;
+    menu_draw_text(glyphs, MenuPoint{at_x(left), at_x(y)}, shade);
+}
+
+// A box with text centred in it, lit when selected.
+void title_draw_box(const std::string &text, s32 x, s32 y, s32 width, bool lit, kf::Language language)
+{
+    const auto &assets = menu_resources().assets;
+    menu_blit_box_translucent(lit ? assets.option_highlight : assets.option_background, MenuPoint{at_x(x), at_x(y)}, width);
+    title_draw_centred(menu_spell(text, language), x, width, y, 1.0f);
+}
+
+// A row: its text in a row box, the cursor on the selected one, its value in an option box.
+void title_draw_row(const kf::TitleRowText &row, s32 index, MenuPoint at, kf::Language language)
+{
+    const auto &assets = menu_resources().assets;
+    const auto label = menu_spell(row.text, language);
+    const s32 box_width = std::max<s32>(assets.row_background.width, menu_text_width(label) + 2 * TITLE_TEXT_INSET);
+    const s32 reach = row.value.empty() ? box_width : TITLE_VALUE_X + TITLE_VALUE_WIDTH - at.x;
+    const bool held = kf::host_menu_row(index, at.x - TITLE_BOX_X_OFFSET, at.y - TITLE_BOX_Y_OFFSET, reach,
+        assets.row_background.height);
+    menu_blit_box_translucent(held ? assets.row_confirmed_background : assets.row_background, at, box_width);
+    if (row.selected)
+        menu_blit_sprite(&assets.selection_cursor, &at);
+    const float shade = row.enabled ? 1.0f : title_dim_shade;
+    menu_draw_text(label, MenuPoint{at_x(at.x + TITLE_TEXT_INSET - TITLE_BOX_X_OFFSET), at.y}, shade);
+    if (row.value.empty())
+        return;
+    menu_blit_box_translucent(row.selected ? assets.option_highlight : assets.option_background,
+        MenuPoint{TITLE_VALUE_X, at.y}, TITLE_VALUE_WIDTH);
+    title_draw_centred(menu_spell(row.value, language), TITLE_VALUE_X, TITLE_VALUE_WIDTH, at.y, shade);
+}
+
+// The top page: its rows centred under the logo.
+void title_draw_top(const kf::TitleText &text, kf::Language language)
+{
+    const s32 box_width = menu_resources().assets.row_background.width;
+    const s32 x = (TITLE_SCREEN_WIDTH - box_width) / 2 + TITLE_BOX_X_OFFSET;
+    for (s32 i = 0; i < static_cast<s32>(text.rows.size()); i++)
+        title_draw_row(text.rows[i], i, MenuPoint{at_x(x), at_x(TITLE_TOP_FIRST_ROW_Y + i * TITLE_ROW_STEP)}, language);
+}
+
+// The join or name page's letters, grid_columns to a line, narrower when a line holds many;
+// returns the y below the grid.
+s32 title_draw_grid(const kf::TitleText &text, s32 y, kf::Language language)
+{
+    const auto &assets = menu_resources().assets;
+    const s32 columns = static_cast<s32>(text.grid_columns);
+    const s32 cells = std::min<s32>(static_cast<s32>(text.rows.size()), static_cast<s32>(text.grid_cells));
+    const s32 step = std::min<s32>(TITLE_GRID_CELL_STEP, (TITLE_SCREEN_WIDTH - 2 * TITLE_ROW_X) / columns);
+    const s32 width = std::min<s32>(TITLE_GRID_CELL_WIDTH, step - TITLE_GRID_CELL_GAP);
+    for (s32 i = 0; i < cells; i++) {
+        const s32 x = TITLE_ROW_X + (i % columns) * step;
+        const s32 row_y = y + (i / columns) * TITLE_ROW_STEP;
+        const bool held = kf::host_menu_row(i, x - TITLE_BOX_X_OFFSET, row_y - TITLE_BOX_Y_OFFSET,
+            width, assets.option_background.height);
+        title_draw_box(text.rows[i].text, x, row_y, width, text.rows[i].selected || held, language);
+    }
+    return y + (cells + columns - 1) / columns * TITLE_ROW_STEP;
+}
+
+// Any other page: the heading, a code, the rows (a window of them around the cursor) and the note.
+void title_draw_page(const kf::TitleText &text, kf::Language language)
+{
+    const auto &assets = menu_resources().assets;
+    const MenuPoint heading_at{TITLE_HEADING_X, TITLE_HEADING_Y};
+    menu_blit_sprite_translucent(&assets.row_background, &heading_at);
+    menu_draw_text(menu_spell(text.heading, language),
+        MenuPoint{TITLE_HEADING_X + TITLE_TEXT_INSET - TITLE_BOX_X_OFFSET, TITLE_HEADING_Y}, 1.0f);
+
+    s32 y = TITLE_FIRST_ROW_Y;
+    // A grid's page keeps its box while the text typed is empty, so the grid does not move.
+    if (!text.code.empty() || text.grid_columns > 0) {
+        // As wide as a long name needs.
+        const s32 width = std::max<s32>(TITLE_CODE_WIDTH, menu_text_width(menu_spell(text.code, language)) + 2 * TITLE_TEXT_INSET);
+        title_draw_box(text.code, (TITLE_SCREEN_WIDTH - width) / 2 + TITLE_BOX_X_OFFSET, y, width, true, language);
+        y += 2 * TITLE_ROW_STEP;
+    }
+    s32 first = 0;
+    if (text.grid_columns > 0) {
+        y = title_draw_grid(text, y, language);
+        first = std::min<s32>(static_cast<s32>(text.rows.size()), static_cast<s32>(text.grid_cells));
+    }
+    const s32 count = static_cast<s32>(text.rows.size());
+    const auto selected = std::find_if(text.rows.begin() + first, text.rows.end(),
+        [](const kf::TitleRowText &row) { return row.selected; });
+    const s32 cursor = selected == text.rows.end() ? first : static_cast<s32>(selected - text.rows.begin());
+    const s32 visible = std::max<s32>(1, std::min<s32>(TITLE_VISIBLE_ROWS, (TITLE_NOTE_Y - y) / TITLE_ROW_STEP));
+    const s32 start = std::clamp<s32>(cursor - visible / 2, first, std::max(first, count - visible));
+    for (s32 i = start; i < count && i < start + visible; i++)
+        title_draw_row(text.rows[i], i, MenuPoint{TITLE_ROW_X, at_x(y + (i - start) * TITLE_ROW_STEP)}, language);
+}
+
+} // namespace
+
+bool menu_title_draw(void)
+{
+    const kf::Language language = game_text_language();
+    const kf::TitleText text = kf::title_text(language);
+    s32 selected = 0;
+    for (s32 i = 0; i < static_cast<s32>(text.rows.size()); i++)
+        if (text.rows[i].selected)
+            selected = i;
+    kf::host_menu_widget(kf::MenuWidget::List, selected);
+    const bool top = text.heading.empty();
+    if (top)
+        title_draw_top(text, language);
+    else
+        title_draw_page(text, language);
+    if (!text.note.empty())
+        title_draw_centred(menu_spell(text.note, language), 0, TITLE_SCREEN_WIDTH, TITLE_NOTE_Y + (top ? 14 : 0), 1.0f);
+    return top;
+}
diff --git a/src/game/message_render.cpp b/src/game/message_render.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..067a5acaedf58714bf5501c9d9340203b5aebeab
--- /dev/null
+++ b/src/game/message_render.cpp
@@ -0,0 +1,64 @@
+// PC extension (messages on the ground, docs/MESSAGES_PLAN.md): a message's mark is a flat, pale
+// quad on the floor of its cell, a third of a cell across, drawn additively so it glows.
+#include <kf/platform/prelude.h>
+#include <kf/game/graphics.h>
+#include <kf/game/render.h>
+#include <kf/lib/geometry_types.h>
+#include <kf/lib/map_data.h>
+#include <kf/lib/render_face.h>
+#include <kf/platform/messages.h>
+
+#include <array>
+
+enum {
+    MESSAGE_MARK_HALF_WIDTH = KF_MAP_TILE_SIZE / 6,  // a third of a cell across
+    MESSAGE_MARK_LIFT = 8,                           // above the floor (up is -y), so it does not z-fight
+};
+
+static constexpr CVECTOR message_mark_colour = {200, 225, 255, 0};
+
+void render_message_mark(const kf::GroundMark &mark, const MATRIX *lights)
+{
+    const auto &view = game_graphics_runtime.render_state;
+    const s32 cell_x = mark.cell_x, cell_z = mark.cell_z;
+    const SVECTOR relative = VECTOR{
+        cell_x * KF_MAP_TILE_SIZE + KF_MAP_TILE_CENTER - view.view_position.vx,
+        map_base_floor_height(cell_x, cell_z) - MESSAGE_MARK_LIFT - view.view_position.vy,
+        cell_z * KF_MAP_TILE_SIZE + KF_MAP_TILE_CENTER - view.view_position.vz}.narrowed();
+    // The mark's corners lie along the world's axes, so the model turns with the view.
+    MATRIX model;
+    MATRIX identity;
+    kf::matrix_set_rotation_xyz(SVECTOR{0, 0, 0, 0}, identity);
+    kf::render_place_model(model, view.view_matrix, relative);
+    kf::matrix_multiply_rotation(view.view_matrix, identity, model);
+
+    const auto centre = kf::render_project_point(model, view.projection, SVECTOR{0, 0, 0, 0});
+    const s32 otz = centre.depth >> KF_GTE_DEPTH_TO_OT_SHIFT;
+    if (otz < KF_SCENE_MIN_OT_DEPTH)
+        return;
+    const std::array<SVECTOR, 4> offsets = {{
+        {-MESSAGE_MARK_HALF_WIDTH, 0, -MESSAGE_MARK_HALF_WIDTH, 0},
+        {MESSAGE_MARK_HALF_WIDTH, 0, -MESSAGE_MARK_HALF_WIDTH, 0},
+        {-MESSAGE_MARK_HALF_WIDTH, 0, MESSAGE_MARK_HALF_WIDTH, 0},
+        {MESSAGE_MARK_HALF_WIDTH, 0, MESSAGE_MARK_HALF_WIDTH, 0}}};
+
+    kf::DrawFace face {};
+    face.shape = kf::FaceShape::Quad;
+    face.casts_shadow = false;
+    face.transparency = kf::FaceTransparency::Blend;
+    face.material = {kf::SurfaceKind::Solid, {}, kf::BlendMode::add};
+    for (unsigned i = 0; i < 4; ++i) {
+        const auto corner = kf::render_project_point(model, view.projection, offsets[i]);
+        face.vertices[i].x = kf::render_subpixel ? corner.fx : corner.x;
+        face.vertices[i].y = kf::render_subpixel ? corner.fy : corner.y;
+        face.vertices[i].w = kf::render_perspective ? corner.w : 0.0f;
+        const bool world = !kf::render_camera_fixed && corner.cz > 0;
+        face.vertices[i].cx = world ? corner.cx : 0.0f;
+        face.vertices[i].cy = world ? corner.cy : 0.0f;
+        face.vertices[i].cz = world ? corner.cz : 0.0f;
+    }
+    const SVECTOR up = {0, -KF_FIXED12_ONE, 0, 0};
+    const kf::DepthCuedColor color = kf::render_light_normal_cued(view.lighting, *lights, up,
+        message_mark_colour, centre.fog);
+    render_face_submit(&face, {&color, 1}, kf::FaceShading::Flat, otz & KF_ORDERING_TABLE_INDEX_MASK);
+}
