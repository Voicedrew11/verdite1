+{
+    s32 tolerance = point_height;
+    const s32 dx = other.camera_position.vx - point_x;
+    const s32 dz = other.camera_position.vz - point_z;
+    if (dx < -max_distance || max_distance < dx || dz < -max_distance || max_distance < dz) {
+        return KF_PROXIMITY_NONE;
+    }
+    if (point_y != KF_COLLISION_IGNORE_HEIGHT) {
+        tolerance >>= 1;
+        const s32 center = point_y - tolerance + KF_COLLISION_PLAYER_HEIGHT / 2;
+        tolerance += KF_COLLISION_PLAYER_HEIGHT / 2;
+        const s32 dy = other.foot_height - center;
+        if (dy < -tolerance || tolerance < dy) {
+            return KF_PROXIMITY_NONE;
+        }
+    }
+    const s32 distance = fixed_vector2_length(dx, dz);
+    return max_distance < distance ? KF_PROXIMITY_NONE : distance;
+}
