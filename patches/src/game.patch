+// PC extension (widescreen): a background quad moved across by shift_x columns,
+// submitted only if it still reaches the picture, which runs columns past each side.
+static void menu_submit_background_copy(kf::DrawFace face, s32 shift_x, s32 columns)
+{
+    const s32 corners = static_cast<s32>(face.shape);
+    float left = face.vertices[0].x + shift_x;
+    float right = left;
+    for (s32 i = 0; i < corners; ++i) {
+        face.vertices[i].x += static_cast<float>(shift_x);
+        left = std::min(left, face.vertices[i].x);
+        right = std::max(right, face.vertices[i].x);
+    }
+    if (right <= static_cast<float>(-columns) || left >= static_cast<float>(kf::render_width + columns)) {
+        return;
+    }
+    menu_submit_template(face, MENU_BACKGROUND_OT_DEPTH);
+}
