 KfActorState actor_state;
 
+// PC extension (online play): each actor goes after the nearest player on the floor, this one or
+// another in the room (docs/COOP_PLAN.md). The AI reads actor_state.player_position, so it is
+// pointed at the actor's target while that actor updates. Alone, the target is always this player.
+std::array<u32, KF_ACTOR_CAPACITY> actor_target_players;
+
+struct ActorPlayerPosition {
+    u32 player;
+    VECTOR position;
+};
+
+static std::vector<ActorPlayerPosition> actor_players_on_floor(const VECTOR &own_position)
+{
+    std::vector<ActorPlayerPosition> players{{KF_ACTOR_TARGET_THIS_PLAYER, own_position}};
+    for (const auto &other : kf::online_players_on_floor(kf_enum_encode<s32>(player_state.progress_state.current_floor))) {
+        // At their eyes, as actor_state.player_position is this player's camera.
+        const VECTOR position = {static_cast<s32>(other.x * static_cast<float>(KF_MAP_TILE_SIZE)),
+            other.foot_height - KF_PLAYER_CAMERA_HEIGHT,
+            static_cast<s32>(other.z * static_cast<float>(KF_MAP_TILE_SIZE))};
+        if (position.vx < 0 || position.vx >= KF_MAP_COLUMNS * KF_MAP_TILE_SIZE
+            || position.vz < 0 || position.vz >= KF_MAP_ROWS * KF_MAP_TILE_SIZE) {
+            continue;
+        }
+        players.push_back({other.id, position});
+    }
+    // PC extension (coop): a player who is down is no one's target, while there is another.
+    if (kf::coop_player_down() && players.size() > 1) {
+        players.erase(players.begin());
+    }
+    return players;
+}
+
+static const ActorPlayerPosition &actor_nearest_player(const KfActor &actor, std::span<const ActorPlayerPosition> players)
+{
+    const ActorPlayerPosition *nearest = &players[0];
+    std::int64_t nearest_squared = INT64_MAX;
+    for (const auto &player : players) {
+        const std::int64_t dx = player.position.vx - actor.position.vx;
+        const std::int64_t dz = player.position.vz - actor.position.vz;
+        if (dx * dx + dz * dz < nearest_squared) {
+            nearest_squared = dx * dx + dz * dz;
+            nearest = &player;
+        }
+    }
+    return *nearest;
+}
+
+std::array<u32, KF_EFFECT_CAPACITY> effect_target_players;
+
+VECTOR actor_player_eyes(u32 player)
+{
+    for (const auto &other : player_others_on_floor()) {
+        if (other.id == player) {
+            return other.camera_position;
+        }
+    }
+    return player_state.camera_position;
+}
+
+bool actor_targets_this_player(void)
+{
+    return actor_target_players[actor_state.current_index] == KF_ACTOR_TARGET_THIS_PLAYER;
+}
+
