+// PC extension (online play): another player in the room, drawn in the world as the knight
+// (docs/PLAYER_MODEL.md). In their right hand is the gauntlet and weapon of the game's own
+// first-person model (WEPON/WEPxx.MIM), turned by its clip at their attack phase so others see the
+// swing its player sees, the arm following it (kf/platform/online_weapon_hold.h). They stand ready,
+// breathing, and walk by the distance they move, in a gait shaped on the game's own skeletons'.
+#include <kf/platform/prelude.h>
+#include <kf/game/equipment.h>
+#include <kf/game/graphics.h>
+#include <kf/game/render.h>
+#include <kf/lib/animation.h>
+#include <kf/lib/byte_reader.h>
+#include <kf/lib/codec.h>
+#include <kf/lib/fixed_math.h>
+#include <kf/lib/geometry_types.h>
+#include <kf/lib/item_types.h>
+#include <kf/lib/map_data.h>
+#include <kf/lib/math.h>
+#include <kf/lib/player_stats_types.h>
+#include <kf/lib/resource_file.h>
+#include <kf/lib/tmd.h>
+#include <kf/platform/host.h>
+#include <kf/platform/online_weapon_hold.h>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <optional>
+#include <vector>
+
+enum {
+    ONLINE_PLAYER_WEAPON_COUNT = 16,
+    ONLINE_PLAYER_WEAPON_FILE_BYTES = 49152,  // KF_WEAPON_ASSET_BUFFER_BYTES
+    ONLINE_PLAYER_HELD_SCALE_SHIFT = 1,       // the first-person gauntlet and weapon are twice a body's
+    ONLINE_PLAYER_HIT_PHASE = 3072,           // PLAYER_WEAPON_HIT_PHASE: the clip's full size
+    ONLINE_PLAYER_COLICHEMARDE_HIT_PHASE = 1000,
+    ONLINE_PLAYER_GAIT_PHASE_END = 4096,
+    ONLINE_PLAYER_GAIT_MIDDLE = 114,          // the thigh's middle angle through a stride (10 degrees)
+    ONLINE_PLAYER_FOREARM_BEND = 137,         // the free forearm bends while walking (12 degrees)
+    ONLINE_PLAYER_HEAD_PITCH_MOST = 683,      // the head follows the camera's pitch this far (60 degrees)
+    ONLINE_PLAYER_BREATH_MS = 3600,
+    ONLINE_PLAYER_BREATH_TORSO = 9,           // the torso leans with a breath (0.8 degrees)
+    ONLINE_PLAYER_BREATH_ARMS = 17,           // and the arms rise with it (1.5 degrees)
+    ONLINE_PLAYER_BREATH_SPREAD = 997,        // each player's breath at its own point
+};
+
+// Standing ready, each part's forward pitch and roll out from the body (4096 a turn); the gait
+// takes over as the stride grows. The left foot a little ahead, knees soft, feet apart, the free
+// arm bent; the weapon arm a little forward and out, its forearm past level so the hand is ahead
+// of the belt, whether standing or walking.
+enum {
+    ONLINE_PLAYER_STANCE_THIGH_RIGHT = -80,   // -7 degrees: behind
+    ONLINE_PLAYER_STANCE_THIGH_LEFT = 102,    // 9 degrees
+    ONLINE_PLAYER_STANCE_THIGH_ROLL = 68,     // 6 degrees
+    ONLINE_PLAYER_STANCE_KNEE_RIGHT = 102,
+    ONLINE_PLAYER_STANCE_KNEE_LEFT = 148,
+    ONLINE_PLAYER_STANCE_UPPER_ARM_LEFT = 91,
+    ONLINE_PLAYER_STANCE_UPPER_ARM_LEFT_ROLL = 80,
+    ONLINE_PLAYER_STANCE_FOREARM_LEFT = 341,  // 30 degrees
+    ONLINE_PLAYER_REST_UPPER_ARM_RIGHT = 205, // 18 degrees
+    ONLINE_PLAYER_REST_UPPER_ARM_RIGHT_ROLL = 102,
+    ONLINE_PLAYER_REST_FOREARM_RIGHT = 774,   // 68 degrees
+};
+
+// One leg through a walk, from its foot leaving the ground behind, linear between keys as the
+// game's keyframes are; shaped on the skeleton's move clip (B1 actor model 5). The thigh swings
+// forward fast to a reach past the contact angle, settles on it and sweeps back over half the cycle.
+struct OnlinePlayerGaitKey {
+    s16 phase;
+    s16 thigh;  // forward of vertical
+    s16 knee;   // bend
+};
+
+static constexpr std::array<OnlinePlayerGaitKey, 4> online_player_gait = {{
+    {0, -250, 159}, {1024, 478, 569}, {2048, 341, 137}, {3072, 46, 182}}};
+
+struct OnlinePlayerLeg {
+    s32 thigh;
+    s32 knee;
+};
+
+static constexpr float ONLINE_PLAYER_TILE_SIZE = KF_MAP_TILE_SIZE;
+
+// A weapon's first-person model, loaded the first time someone holds it.
+struct OnlineWeaponModel {
+    std::vector<u8> bytes;
+    KfTmdResource tmd;
+    KfAnimationData animation;
+    std::vector<SVECTOR> rest;   // the TMD's own vertices, before any morph
+    kf::OnlineWeaponHold hold;
+    // As drawn: the hit's vertices halved, the model's forearm folded onto the wrist so its faces
+    // have no area and are culled.
+    std::vector<SVECTOR> held;
+};
+
+struct OnlineWeaponSlot {
+    bool tried;
+    std::optional<OnlineWeaponModel> model;
+};
+
+static std::array<OnlineWeaponSlot, ONLINE_PLAYER_WEAPON_COUNT> online_weapon_slots;
+
+static KfTmdContext online_player_tmd_context(const KfTmdResource &resource)
+{
+    auto context = tmd_context();
+    context.current_tmd = resource;
+    context.current_vertices = {};
+    return context;
+}
+
+static std::optional<OnlineWeaponModel> online_weapon_load(u8 weapon)
+{
+    OnlineWeaponModel model;
+    model.bytes.resize(ONLINE_PLAYER_WEAPON_FILE_BYTES);
+    std::array<char, 16> path = {"WEPON/WEP00.MIM"};
+    path[9] = static_cast<char>('0' + weapon / 10);
+    path[10] = static_cast<char>('0' + weapon % 10);
+    std::size_t size = 0;
+    if (resource_file_load_into(model.bytes.data(), model.bytes.size(), path.data(), &size) != KF_RESOURCE_LOADED)
+        return std::nullopt;
+    model.bytes.resize(size);
+    try {
+        const KfAsset asset({model.bytes.data(), model.bytes.size()});
+        if (!asset.animated() || asset.tmd_offset() % alignof(KfTmdHeader) != 0)
+            return std::nullopt;
+        model.tmd = tmd_resource_view(model.bytes.data() + asset.tmd_offset(), asset.tmd().size());
+        const auto context = online_player_tmd_context(model.tmd);
+        const auto object = tmd_read_object(context, 0);
+        if (object.vertex_count == 0 || object.vertex_count > KF_MORPH_SCRATCH_CAPACITY)
+            return std::nullopt;
+        tmd_select_object_vertices(context, 0);
+        const auto vertices = tmd_vertices(context, static_cast<s32>(object.vertex_count));
+        model.rest.assign(vertices.begin(), vertices.end());
+        model.animation = asset.animation(object.vertex_count);
+    } catch (const kf::codec::Error &error) {
+        error.report();
+        return std::nullopt;
+    }
+    if (model.animation.clips.empty())
+        return std::nullopt;
+    return model;
+}
+
+static void online_weapon_add_morph(std::span<SVECTOR> vertices, const KfAnimationData &animation,
+    u16 morph_index, s32 blend)
+{
+    if (morph_index >= animation.morphs.size())
+        return;
+    const auto &morph = animation.morphs[morph_index];
+    for (std::size_t i = 0; i < morph.delta_count; ++i) {
+        SVECTOR &vertex = vertices[morph.base_vertex + i];
+        const auto &delta = animation.deltas[morph.first_delta + i];
+        vertex.vx = static_cast<s16>(vertex.vx + ((delta.x * blend) >> KF_FIXED12_BITS));
+        vertex.vy = static_cast<s16>(vertex.vy + ((delta.y * blend) >> KF_FIXED12_BITS));
+        vertex.vz = static_cast<s16>(vertex.vz + ((delta.z * blend) >> KF_FIXED12_BITS));
+    }
+}
+
+// The model's vertices at a phase of its clip, as render_bind_instance_vertices samples one.
+static void online_weapon_sample(const OnlineWeaponModel &model, u16 phase, std::span<SVECTOR> vertices)
+{
+    const auto &animation = model.animation;
+    const auto &clip = animation.clips[kf_enum_encode<u16>(KF_ANIMATION_CLIP_FIRST)];
+    std::copy(model.rest.begin(), model.rest.end(), vertices.begin());
+    std::size_t index = clip.keyframe_count - 1;
+    s32 blend = KF_FIXED12_ONE;
+    u32 phase_end = 0;
+    for (std::size_t i = 0; i < clip.keyframe_count; ++i) {
+        const auto &keyframe = animation.keyframes[clip.first_keyframe + i];
+        const u32 phase_start = phase_end;
+        phase_end += keyframe.duration;
+        if (phase < phase_end) {
+            const s32 forward = static_cast<s32>(((phase - phase_start) << KF_FIXED12_BITS) / keyframe.duration);
+            index = i;
+            blend = keyframe.reverse ? KF_FIXED12_ONE - forward : forward;
+            break;
+        }
+    }
+    const auto &keyframe = animation.keyframes[clip.first_keyframe + index];
+    for (std::size_t i = 0; i < keyframe.morph_count; ++i)
+        online_weapon_add_morph(vertices, animation, animation.indices[keyframe.first_morph + i], KF_FIXED12_ONE);
+    online_weapon_add_morph(vertices, animation, keyframe.rest_morph, blend);
+}
+
+// The model's faces, for finding its pieces.
+static std::vector<kf::OnlineModelFace> online_weapon_faces(const OnlineWeaponModel &model)
+{
+    std::vector<kf::OnlineModelFace> faces;
+    const auto context = online_player_tmd_context(model.tmd);
+    const auto object = tmd_read_object(context, 0);
+    auto stream = tmd_primitive_stream(context, object);
+    while (stream.remaining != 0) {
+        const auto packet = tmd_next_packet(stream);
+        u8 corners;
+        switch (tmd_opaque_mode(packet.mode)) {
+        case KF_TMD_MODE_F3: case KF_TMD_MODE_FT3: case KF_TMD_MODE_G3: case KF_TMD_MODE_GT3:
+            corners = 3;
+            break;
+        case KF_TMD_MODE_F4: case KF_TMD_MODE_FT4: case KF_TMD_MODE_G4: case KF_TMD_MODE_GT4:
+            corners = 4;
+            break;
+        default:
+            continue;
+        }
+        const auto face = tmd_decode_face(packet, object.vertex_count);
+        faces.push_back({face.vertices, corners});
+    }
+    return faces;
+}
+
+// The model's space into the knight's body: the first-person orientation, turned a half turn
+// since the camera looks along +z and actors along -z.
+static kf::OnlineRotation online_weapon_view(u8 weapon)
+{
+    MATRIX turned;
+    MATRIX view_model;
+    kf::matrix_set_rotation_xyz(weapon_records.entries[weapon].render_rotation, view_model);
+    kf::matrix_set_rotation_xyz(SVECTOR{0, KF_ANGLE_HALF_TURN, 0}, turned);
+    kf::matrix_multiply_rotation(turned, view_model, view_model);
+    return kf::online_rotation(view_model);
+}
+
+// How the knight holds the weapon, and what it draws of the model: the hit's vertices halved,
+// the model's forearm folded onto the wrist.
+static bool online_weapon_prepare(OnlineWeaponModel &model, u8 weapon)
+{
+    const u16 hit = weapon == kf_enum_encode<u8>(KF_ITEM_COLICHEMARDE) ? ONLINE_PLAYER_COLICHEMARDE_HIT_PHASE : ONLINE_PLAYER_HIT_PHASE;
+    model.held.resize(model.rest.size());
+    online_weapon_sample(model, hit, model.held);
+    auto hold = kf::online_weapon_hold(model.held, online_weapon_faces(model), online_weapon_view(weapon));
+    if (!hold)
+        return false;
+    model.hold = std::move(*hold);
+    for (const u16 vertex : model.hold.forearm)
+        model.held[vertex] = model.hold.wrist;
+    for (auto &vertex : model.held) {
+        vertex.vx = static_cast<s16>(vertex.vx >> ONLINE_PLAYER_HELD_SCALE_SHIFT);
+        vertex.vy = static_cast<s16>(vertex.vy >> ONLINE_PLAYER_HELD_SCALE_SHIFT);
+        vertex.vz = static_cast<s16>(vertex.vz >> ONLINE_PLAYER_HELD_SCALE_SHIFT);
+    }
+    return true;
+}
+
+static const OnlineWeaponModel *online_weapon_model(u8 weapon)
+{
+    if (weapon >= ONLINE_PLAYER_WEAPON_COUNT)
+        return nullptr;
+    auto &slot = online_weapon_slots[weapon];
+    if (!slot.tried) {
+        slot.tried = true;
+        slot.model = online_weapon_load(weapon);
+        if (slot.model && !online_weapon_prepare(*slot.model, weapon))
+            slot.model.reset();
+    }
+    return slot.model ? &*slot.model : nullptr;
+}
+
+// A leg at a phase of the walk, scaled by the stride (KF_FIXED12_ONE a full one).
+static OnlinePlayerLeg online_player_leg(s32 phase, s32 stride)
+{
+    phase &= ONLINE_PLAYER_GAIT_PHASE_END - 1;
+    std::size_t key = online_player_gait.size() - 1;
+    while (phase < online_player_gait[key].phase)
+        --key;
+    const auto &from = online_player_gait[key];
+    const auto &to = online_player_gait[(key + 1) % online_player_gait.size()];
+    const s32 end = key + 1 < online_player_gait.size() ? to.phase : ONLINE_PLAYER_GAIT_PHASE_END;
+    const s32 along = ((phase - from.phase) << KF_FIXED12_BITS) / (end - from.phase);
+    const s32 thigh = from.thigh + (((to.thigh - from.thigh) * along) >> KF_FIXED12_BITS);
+    const s32 knee = from.knee + (((to.knee - from.knee) * along) >> KF_FIXED12_BITS);
+    return {(thigh * stride) >> KF_FIXED12_BITS, (knee * stride) >> KF_FIXED12_BITS};
+}
+
+// How far below the hip a leg reaches: the body is lowered so the longer one stands on the floor.
+static s32 online_player_leg_reach(const OnlinePlayerLeg &leg, s32 thigh_length, s32 shin_length)
+{
+    return (thigh_length * kf::angle_cosine(leg.thigh) + shin_length * kf::angle_cosine(leg.thigh - leg.knee))
+        >> KF_FIXED12_BITS;
+}
+
+struct OnlinePlayerPose {
+    std::array<SVECTOR, kf::online_player_part_count> turns;  // about each part's pivot: pitch (forward is
+                                                              // negative), roll (out from the body on the right)
+    s32 drop;                                                 // the body lowered to stand on the planted foot
+};
+
+// Where a player is through a breath, from -KF_FIXED12_ONE to KF_FIXED12_ONE.
+static s32 online_player_breath(const kf::OnlinePlayer &player)
+{
+    const std::uint64_t ms = kf::host_clock_ns() / 1000000;
+    const u32 through = static_cast<u32>((ms % ONLINE_PLAYER_BREATH_MS) * KF_ANGLE_FULL_TURN / ONLINE_PLAYER_BREATH_MS);
+    return kf::angle_sine(static_cast<s32>((through + player.id * ONLINE_PLAYER_BREATH_SPREAD) & KF_ANGLE_WRAP_MASK));
+}
+
+// The knight standing ready, breathing, or walking: legs half a cycle apart, the free arm swung
+// against the right leg, the head tilted as the player looks up or down. The weapon arm is at rest
+// here; a held weapon's hold turns it through a swing.
+static OnlinePlayerPose online_player_pose(const kf::OnlinePlayer &player)
+{
+    using Part = kf::OnlinePlayerPart;
+    const auto &joints = kf::online_player_model_joints();
+    const s32 stride = std::clamp(static_cast<s32>(std::lround(player.stride * KF_FIXED12_ONE)), 0, KF_FIXED12_ONE);
+    const s32 phase = static_cast<s32>(std::lround(player.stride_phase * static_cast<float>(ONLINE_PLAYER_GAIT_PHASE_END)));
+    const auto gait_right = online_player_leg(phase, stride);
+    const auto gait_left = online_player_leg(phase + ONLINE_PLAYER_GAIT_PHASE_END / 2, stride);
+    const auto part = [](Part part) { return kf_enum_encode<u8>(part); };
+    // A stance angle, fading as the stride grows.
+    const auto standing = [stride](s32 angle) { return static_cast<s16>((angle * (KF_FIXED12_ONE - stride)) >> KF_FIXED12_BITS); };
+    const s32 breath = online_player_breath(player);
+    const s16 breath_arms = standing((ONLINE_PLAYER_BREATH_ARMS * breath) >> KF_FIXED12_BITS);
+    const OnlinePlayerLeg right = {gait_right.thigh + standing(ONLINE_PLAYER_STANCE_THIGH_RIGHT),
+        gait_right.knee + standing(ONLINE_PLAYER_STANCE_KNEE_RIGHT)};
+    const OnlinePlayerLeg left = {gait_left.thigh + standing(ONLINE_PLAYER_STANCE_THIGH_LEFT),
+        gait_left.knee + standing(ONLINE_PLAYER_STANCE_KNEE_LEFT)};
+
+    OnlinePlayerPose pose{};
+    pose.turns[part(Part::ThighRight)] = {static_cast<s16>(-right.thigh), 0, standing(ONLINE_PLAYER_STANCE_THIGH_ROLL)};
+    pose.turns[part(Part::ShinRight)] = {static_cast<s16>(right.knee), 0, 0};
+    pose.turns[part(Part::ThighLeft)] = {static_cast<s16>(-left.thigh), 0, static_cast<s16>(-standing(ONLINE_PLAYER_STANCE_THIGH_ROLL))};
+    pose.turns[part(Part::ShinLeft)] = {static_cast<s16>(left.knee), 0, 0};
+    pose.turns[part(Part::Torso)] = {standing((ONLINE_PLAYER_BREATH_TORSO * breath) >> KF_FIXED12_BITS), 0, 0};
+    pose.turns[part(Part::UpperArmLeft)] = {static_cast<s16>(-standing(ONLINE_PLAYER_STANCE_UPPER_ARM_LEFT)
+        - 2 * (gait_right.thigh - ((ONLINE_PLAYER_GAIT_MIDDLE * stride) >> KF_FIXED12_BITS)) / 5 - breath_arms),
+        0, static_cast<s16>(-standing(ONLINE_PLAYER_STANCE_UPPER_ARM_LEFT_ROLL))};
+    pose.turns[part(Part::ForearmLeft)] = {static_cast<s16>(-standing(ONLINE_PLAYER_STANCE_FOREARM_LEFT)
+        - ((ONLINE_PLAYER_FOREARM_BEND * stride) >> KF_FIXED12_BITS)), 0, 0};
+    pose.turns[part(Part::UpperArmRight)] = {static_cast<s16>(-ONLINE_PLAYER_REST_UPPER_ARM_RIGHT - breath_arms), 0,
+        ONLINE_PLAYER_REST_UPPER_ARM_RIGHT_ROLL};
+    pose.turns[part(Part::ForearmRight)] = {-ONLINE_PLAYER_REST_FOREARM_RIGHT, 0, 0};
+    // An upright part tips forward at a positive bend, as the camera looks down at a positive pitch.
+    pose.turns[part(Part::Head)] = {static_cast<s16>(
+        std::clamp<s32>(player.pitch, -ONLINE_PLAYER_HEAD_PITCH_MOST, ONLINE_PLAYER_HEAD_PITCH_MOST)), 0, 0};
+
+    const auto &hip = joints[part(Part::ThighRight)].pivot;
+    const auto &knee = joints[part(Part::ShinRight)].pivot;
+    const s32 thigh_length = knee.vy - hip.vy;  // up is -y, the feet at 0
+    const s32 shin_length = -knee.vy;
+    const s32 reach = std::max(online_player_leg_reach(right, thigh_length, shin_length),
+        online_player_leg_reach(left, thigh_length, shin_length));
+    pose.drop = thigh_length + shin_length - reach;
+    return pose;
+}
+
+// The weapon arm's parts in the body: the stance's at rest, through a swing as the hold has them
+// at the attack phase.
+static kf::OnlineWeaponArm online_player_weapon_arm(const kf::OnlinePlayer &player, const OnlineWeaponModel &model,
+    const MATRIX &upper_arm, const MATRIX &forearm)
+{
+    const auto rest = kf::online_weapon_arm_at_rest(model.hold, kf::online_rotation(upper_arm), kf::online_rotation(forearm));
+    if (player.attack_phase == kf::online_not_attacking)
+        return rest;
+    const auto vertices = std::span(game_graphics_runtime.morph_scratch).first(model.rest.size());
+    online_weapon_sample(model, static_cast<u16>(player.attack_phase), vertices);
+    const auto &followed = model.hold.followed;
+    const std::array<SVECTOR, 3> at_phase = {vertices[followed[0]], vertices[followed[1]], vertices[followed[2]]};
+    return kf::online_weapon_arm_swinging(model.hold, rest, at_phase, kf::online_attack_weight(player.attack_phase));
+}
+
+struct OnlinePlayerPlacement {
+    MATRIX rotation;   // the part's orientation in the world
+    VECTOR position;   // its pivot in the world
+};
+
+static void online_player_draw_object(const KfTmdResource &tmd, u16 object_index,
+    std::span<const SVECTOR> vertices, const OnlinePlayerPlacement &placement)
+{
+    SVECTOR relative_position;
+    MATRIX composed;
+    MATRIX light;
+
+    relative_position = VECTOR{
+        placement.position.vx - game_graphics_runtime.render_state.view_position.vx,
+        placement.position.vy - game_graphics_runtime.render_state.view_position.vy,
+        placement.position.vz - game_graphics_runtime.render_state.view_position.vz}.narrowed();
+    kf::render_place_model(composed, game_graphics_runtime.render_state.view_matrix, relative_position);
+    kf::matrix_multiply_rotation(game_graphics_runtime.render_state.view_matrix, placement.rotation, composed);
+    kf::matrix_multiply_rotation(render_light_matrices[KF_RENDER_LIGHT_ACTOR], placement.rotation, light);
+    auto context = tmd_context();
+    context.current_tmd = tmd;
+    const auto object = tmd_read_object(context, object_index);
+    if (vertices.empty())
+        tmd_select_object_vertices(context, object_index);
+    else
+        context.current_vertices = vertices;
+    tmd_project_vertices(static_cast<s32>(object.vertex_count), &composed, game_graphics_runtime.render_state.projection);
+    render_enqueue_tmd(object_index, 0, &light);
+}
+
+static VECTOR online_player_offset(const MATRIX &rotation, const SVECTOR &to, const SVECTOR &from)
+{
+    return kf::matrix_apply_rotation(rotation, VECTOR{to.vx - from.vx, to.vy - from.vy, to.vz - from.vz}.narrowed());
+}
+
+// The held gauntlet and weapon, their wrist on the end of the right forearm.
+static void online_player_draw_held(const OnlineWeaponModel &model, const MATRIX &body, const MATRIX &held,
+    const OnlinePlayerPlacement &forearm)
+{
+    const auto &elbow = kf::online_player_model_joints()[kf_enum_encode<u8>(kf::OnlinePlayerPart::ForearmRight)].pivot;
+    const SVECTOR wrist = {static_cast<s16>(model.hold.wrist.vx >> ONLINE_PLAYER_HELD_SCALE_SHIFT),
+        static_cast<s16>(model.hold.wrist.vy >> ONLINE_PLAYER_HELD_SCALE_SHIFT),
+        static_cast<s16>(model.hold.wrist.vz >> ONLINE_PLAYER_HELD_SCALE_SHIFT), 0};
+    OnlinePlayerPlacement placement;
+    kf::matrix_multiply_rotation(body, held, placement.rotation);
+    const VECTOR from_wrist = kf::matrix_apply_rotation(placement.rotation, wrist);
+    placement.position = forearm.position;
+    placement.position += online_player_offset(forearm.rotation, kf::online_player_model_right_wrist(), elbow);
+    placement.position.vx -= from_wrist.vx;
+    placement.position.vy -= from_wrist.vy;
+    placement.position.vz -= from_wrist.vz;
+    online_player_draw_object(model.tmd, 0, model.held, placement);
+}
+
+void render_online_player(const kf::OnlinePlayer &player)
+{
+    using Part = kf::OnlinePlayerPart;
+    // In the player's colour, wearing their helmet (port/ext/coop_profile.h).
+    const auto painted = kf::online_player_tmd_in(player.colour);
+    const auto knight = tmd_resource_view(painted.data(), painted.size());
+    const u8 helmet = player.helmet < kf::online_player_helmet_count ? player.helmet : 0;
+    const auto &joints = kf::online_player_model_joints();
+    const auto pose = online_player_pose(player);
+    const VECTOR feet = {
+        static_cast<s32>(player.x * ONLINE_PLAYER_TILE_SIZE),
+        player.foot_height + pose.drop,
+        static_cast<s32>(player.z * ONLINE_PLAYER_TILE_SIZE)};
+    // The automap's yaw, back in the game's angle units, is the camera's heading h; the player
+    // walks along (-sin h, cos h). Actors walk along (-sin a, -cos a), their models' front, so the
+    // knight faces where the camera looks at a = half turn - h.
+    const auto heading = static_cast<s32>(std::lround(player.yaw * (KF_ANGLE_FULL_TURN / 6.2831853f)));
+    MATRIX body;
+    kf::matrix_set_rotation_xyz(SVECTOR{0, static_cast<s16>((KF_ANGLE_HALF_TURN - heading) & KF_ANGLE_WRAP_MASK), 0}, body);
+
+    // Each part's turn in the body, parents first.
+    std::array<MATRIX, kf::online_player_part_count> turned;
+    for (std::size_t i = 0; i < joints.size(); ++i) {
+        MATRIX bend;
+        kf::matrix_set_rotation_xyz(pose.turns[i], bend);
+        if (joints[i].parent < 0)
+            turned[i] = bend;
+        else
+            kf::matrix_multiply_rotation(turned[static_cast<u8>(joints[i].parent)], bend, turned[i]);
+    }
+    // A held weapon turns the weapon arm; the right hand, under its gauntlet, is not drawn.
+    const OnlineWeaponModel *weapon = online_weapon_model(player.weapon);
+    const auto upper_arm_right = kf_enum_encode<u8>(Part::UpperArmRight);
+    const auto forearm_right = kf_enum_encode<u8>(Part::ForearmRight);
+    MATRIX held{};
+    if (weapon) {
+        const auto arm = online_player_weapon_arm(player, *weapon, turned[upper_arm_right], turned[forearm_right]);
+        turned[upper_arm_right] = kf::online_matrix(arm.upper_arm);
+        turned[forearm_right] = kf::online_matrix(arm.forearm);
+        held = kf::online_matrix(kf::online_compose(arm.held, weapon->hold.view));
+    }
+
+    std::array<OnlinePlayerPlacement, kf::online_player_part_count> placements;
+    for (std::size_t i = 0; i < joints.size(); ++i) {
+        const auto &joint = joints[i];
+        auto &placement = placements[i];
+        kf::matrix_multiply_rotation(body, turned[i], placement.rotation);
+        if (joint.parent < 0) {
+            placement.position = feet;
+            placement.position += kf::matrix_apply_rotation(body, joint.pivot);
+        } else {
+            const auto parent_index = static_cast<std::size_t>(static_cast<u8>(joint.parent));
+            const auto &parent = placements[parent_index];
+            placement.position = parent.position;
+            placement.position += online_player_offset(parent.rotation, joint.pivot, joints[parent_index].pivot);
+        }
+        if (weapon && i == kf_enum_encode<u8>(Part::HandRight))
+            continue;
+        online_player_draw_object(knight, static_cast<u16>(i), {}, placement);
+        if (i == kf_enum_encode<u8>(Part::Head))
+            online_player_draw_object(knight, kf::online_player_model_helmet_object(helmet), {}, placement);
+    }
+    if (weapon)
+        online_player_draw_held(*weapon, body, held, placements[forearm_right]);
+}
