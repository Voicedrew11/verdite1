+static std::vector<MenuTextGlyph> menu_item_menu_spell(const kf::ItemMenuLine &pieces, kf::Language language)
+{
+    std::vector<MenuTextGlyph> line;
+    for (const kf::MessageTextPiece &piece : pieces) {
+        if (piece.text == kf::item_menu_blank)
+            menu_item_menu_blank(line, language);
+        else
+            menu_spell_onto(line, piece.text, language);
+        if (piece.item != kf::message_text_only)
