+template <std::size_t N>
+MenuGlyphRow menu_stat_row(const std::array<s16, N> &sequence)
+{
+    MenuGlyphRow row{};
+    std::copy_n(sequence.begin(), std::min<std::size_t>(N, MENU_GLYPHS_PER_ROW), row.codes.begin());
