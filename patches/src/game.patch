+void menu_draw_text(std::span<const MenuTextGlyph> glyphs, MenuPoint at, float shade, s32 depth)
+{
+    const MenuSpriteDef &label_font = menu_resources().assets.glyph_atlas;
+    const MenuSpriteDef &number_font = menu_resources().assets.number_atlas;
+    s32 x = at.x;
+
+    for (const MenuTextGlyph &glyph : glyphs) {
+        const bool number = glyph.font == MenuTextFont::Number;
+        const MenuSpriteDef *latin_font = glyph.font == MenuTextFont::Latin ? menu_latin_font() : nullptr;
+        if (glyph.font == MenuTextFont::Latin && !latin_font) {
+            x += glyph.advance;
+            continue;
+        }
+        const MenuSpriteDef &font = number ? number_font : latin_font ? *latin_font : label_font;
+        std::array<std::array<s32, 2>, 3> uvs{};
+        s32 layers = 0;
+        if (number) {
+            uvs[layers++] = {font.u, glyph.code * MENU_NUMBER_CELL_HEIGHT};
+        } else {
+            const s32 cell = glyph.code & MENU_TEXT_GLYPH_MASK;
+            uvs[layers++] = {(cell % MENU_FONT_COLUMNS) * MENU_FONT_CELL_WIDTH, (cell / MENU_FONT_COLUMNS) * MENU_FONT_CELL_HEIGHT};
+            if (glyph.code & MENU_TEXT_DAKUTEN)
+                uvs[layers++] = {MENU_DAKUTEN_U, MENU_KANA_MARK_V};
+            if (glyph.code & MENU_TEXT_HANDAKUTEN)
+                uvs[layers++] = {MENU_HANDAKUTEN_U, MENU_KANA_MARK_V};
+        }
+        for (s32 i = 0; i < layers; i++) {
+            auto face = menu_textured_quad(font.material, x - glyph.left, at.y + (number ? 1 : 0), font.width, font.height);
+            render_face_uv_rectangle(&face, uvs[i][0], uvs[i][1], uvs[i][0] + font.width, uvs[i][1] + font.height);
+            for (auto &vertex : face.vertices) {
+                vertex.r *= shade;
+                vertex.g *= shade;
+                vertex.b *= shade;
+            }
+            menu_submit_template(face, depth);
+        }
+        x += glyph.advance;
+    }
+}
