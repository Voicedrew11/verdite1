+        auto face = menu_textured_quad(sprite.material, screen_x, y, screen_width, sprite.height);
+        render_face_uv_rectangle(&face, u, sprite.v, u + texture_width, sprite.v + sprite.height);
+        face.transparency = kf::FaceTransparency::Blend;
+        menu_submit_template(face, MENU_WIDGET_OT_DEPTH);
