+struct ItemMenuBinding {
+    kf::Button button;
+    kf::ItemMenuKey key;
+    KfMenuSoundCue cue;
+};
+constexpr std::array<ItemMenuBinding, 4> item_menu_bindings = {{
+    {kf::Button::Up, kf::ItemMenuKey::Up, MENU_SOUND_CURSOR},
+    {kf::Button::Down, kf::ItemMenuKey::Down, MENU_SOUND_CURSOR},
+    {kf::Button::Confirm, kf::ItemMenuKey::Confirm, MENU_SOUND_CONFIRM},
+    {kf::Button::Back, kf::ItemMenuKey::Back, MENU_SOUND_CANCEL_OR_ERROR},
+}};
+
+// One pad read: the first press with a binding goes to the page, with its cue.
+static kf::ItemMenuState menu_item_menu_input(u32 input, u32 prev)
+{
+    for (const ItemMenuBinding &binding : item_menu_bindings) {
+        if (!kf::button_pressed(input, prev, binding.button))
+            continue;
+        menu_play_input_sound(binding.cue);
+        return kf::item_menu_press(binding.key);
+    }
+    return kf::ItemMenuState::Open;
+}
+
+kf::ItemMenuState menu_item_menu(void)
+{
+    kf::ItemMenuState state = kf::ItemMenuState::Open;
+    u32 input = 0;
+    u32 prev;
+
+    kf::host_wait_buttons_released();
+    while (state == kf::ItemMenuState::Open) {
+        menu_frame_begin();
+        prev = input;
+        input = kf::host_read_buttons();
+        state = menu_item_menu_input(input, prev);
+        menu_item_menu_draw_page();
+        menu_present_frame();
+    }
+    kf::host_wait_buttons_released();
+    return state;
+}
