+void menu_draw_pickup_feed(void)
+{
+    constexpr s16 feed_left_x = 8, feed_top_y = 28, feed_row_step = 14;
+    const auto language = kf::game_language();
+    s16 y = feed_top_y;
+    for (const kf::CoopFeedRow &row : kf::coop_feed_view(language)) {
+        std::vector<MenuTextGlyph> glyphs = menu_spell(row.before, language);
+        if (row.item < KF_ITEM_COUNT)
