+    const s32 columns = kf::host_extra_columns();
+    for (s32 shift = kf::render_width; shift - kf::render_width < columns; shift += kf::render_width) {
+        for (const auto &face : background) {
+            menu_submit_background_copy(face, -shift, columns);
