+// PC fix: a blocked cell on the map's edge read its neighbour past the grid on
+// the PS1; outside the map is rock.
+static bool effect_neighbour_has_full_floor(s32 x, s32 z)
+{
+    if (x < 0 || x >= KF_MAP_COLUMNS || z < 0 || z >= KF_MAP_ROWS) {
+        return false;
+    }
+    return map_cell_has_full_floor(map_collision_grid.cells[z][x]);
