+    // PGXP follows a projected coordinate through the CPU, so it needs to see the
+    // instructions that move one: every load, store, move and arithmetic op that
+    // could carry a vertex from the GTE's scratch into a primitive packet. There is
+    // nowhere to observe that from -- a static recompilation has no interpreter loop
+    // -- so the observation is emitted beside the work.
+    //
+    // The gate is emitted, not taken inside the hook: `Pgxp.CpuTracking` is a static
+    // bool, so with PGXP off the cost of all of this is a predictable branch rather
+    // than a call. Every PgxpCpu method re-checks it anyway.
+    static string Hook(string call) =>
+        $" if (RecompOne.Runtime.Pgxp.Pgxp.CpuTracking) RecompOne.Runtime.Pgxp.PgxpCpu.{call};";
+
+    // An op whose hook wants a source register's value from *before* the op ran, for
+    // the cases where the destination is also the source.
+    static string Track1(string body, string call, int reg) =>
+        $"{{ var _v = {R(reg)}; {body}{Hook(call)} }}";
+
+    static string Track2(string body, string call, int rs, int rt) =>
+        $"{{ var _s = {R(rs)}; var _t = {R(rt)}; {body}{Hook(call)} }}";
+
+    // Loads and stores hold the address in a local rather than emitting the address
+    // expression twice. `lw $t0, 0($t0)` overwrites its own base register, so a
+    // second evaluation after the load would hand the hook an address the access
+    // never used -- and binding a vertex to the wrong word is exactly the failure
+    // this whole mechanism exists to avoid.
+    static string TrackMem(string body, string call, int rs, short imm) =>
+        $"{{ var _a = {Addr(rs, imm)}; {body}{Hook(call)} }}";
+
