diff --git a/tools/RecompOne/RecompOne.Runtime/Gpu/RemasterUniforms.cs b/tools/RecompOne/RecompOne.Runtime/Gpu/RemasterUniforms.cs
index ec030ae..3579ea7 100644
--- a/tools/RecompOne/RecompOne.Runtime/Gpu/RemasterUniforms.cs
