# Build output (contains disc-derived bytes once the English delta is embedded)
/build/
/result
/result-*
__pycache__/
*.pyc

# tools/patches.py working copy
/work/

# Game data and disc images (never commit these)
/data/
*.bin
*.cue
*.iso
*.img
*.ccd
*.sub
*.chd
*.ppf
*.kfs
*.kfdelta
# except the made-up test images (no game data) from tools/make_disc_fixtures.py
!/libverdite/tests/data/disc/*
/dist/

# The game's user folder and crash reports when it runs without one (settings.cpp, crash.cpp)
/user/
/crashes/

# scripts/fuzz.py runs and reports
/fuzz/
# Gradle's output for the Android APK
android/.gradle/
android/app/build/
android/local.properties
android/build/

# Secrets never go in the repo (online/README.md, "Secrets"); the pre-commit hook also refuses them
.dev.vars*
.env
.env.*
*.pem
*.p12
*.pfx
.wrangler/
