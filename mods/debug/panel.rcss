/* The debug panel: a plain dark window at the top left, every control a press. */
div, p, h2 {
	display: block;
}

body {
	font-family: Mincho;
	font-size: 15dp;
	color: #e8e2cc;
	width: 100%;
	height: 100%;
	pointer-events: none;
}

#window {
	position: absolute;
	left: 16dp;
	top: 16dp;
	width: 520dp;
	max-height: 86%;
	display: flex;
	flex-direction: column;
	border: 1dp #6a6f9a;
	border-radius: 4dp;
	background-color: #0c0d1ce8;
	pointer-events: auto;
}

#title {
	padding: 8dp 12dp 4dp 12dp;
	color: #ffe6aa;
	font-size: 17dp;
}

#tabs {
	padding: 0 8dp 6dp 8dp;
	border-bottom: 1dp #2c2f52;
}

tab {
	display: inline-block;
	padding: 3dp 9dp;
	color: #9a96a8;
	cursor: pointer;
}

tab:hover {
	color: #e8e2cc;
}

tab.chosen {
	color: #ffe6aa;
	border-bottom: 2dp #ffe6aa;
}

#body {
	flex: 1;
	overflow-y: auto;
	padding: 8dp 12dp 12dp 12dp;
	min-height: 0;
}

h2 {
	color: #ffe6aa;
	font-size: 15dp;
	margin: 10dp 0 4dp 0;
	border-bottom: 1dp #2c2f52;
}

p {
	margin: 2dp 0;
}

p.help {
	color: #8a8698;
	font-size: 13dp;
	margin: 0 0 4dp 0;
}

p.warning {
	color: #ff7466;
}

p.dim {
	color: #8a8698;
}

.line {
	display: block;
	margin: 3dp 0;
}

.row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 2dp 4dp;
	border-radius: 3dp;
	cursor: pointer;
}

.row:hover {
	background-color: #ffe6aa18;
}

.label {
	flex: 1;
}

.value {
	min-width: 60dp;
	text-align: center;
	color: #9a96a8;
}

.value.on {
	color: #ffe6aa;
}

button {
	display: inline-block;
	padding: 2dp 9dp;
	margin: 2dp 4dp 2dp 0;
	border: 1dp #6a6f9a;
	border-radius: 3dp;
	cursor: pointer;
}

button:hover {
	border-color: #ffe6aa;
	color: #ffe6aa;
}

button.step {
	padding: 1dp 6dp;
	margin: 0 2dp;
	font-size: 13dp;
}

input {
	display: block;
	width: 180dp;
	padding: 2dp 6dp;
	border: 1dp #6a6f9a;
	border-radius: 3dp;
	background-color: #08091480;
	cursor: text;
}

input:focus {
	border-color: #ffe6aa;
}

/* A scroll area's bar: RmlUi gives it no size of its own, so unstyled it covers the content. */
scrollbarvertical {
	width: 6dp;
	margin-left: 4dp;
}

scrollbarvertical slidertrack {
	background-color: #00000000;
}

scrollbarvertical sliderbar {
	background-color: #2c2f52;
	border-radius: 3dp;
}

scrollbarvertical sliderbar:hover {
	background-color: #6a6f9a;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
	width: 0;
	height: 0;
}

scrollbarhorizontal {
	height: 6dp;
}

scrollbarhorizontal sliderbar {
	background-color: #2c2f52;
}
