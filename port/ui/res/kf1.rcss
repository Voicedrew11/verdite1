/* The interface's look for King's Field, laid out as holyland's player menu: a framed window with iron corners, a
   sidebar with the Verdite logo and the pages, the page's title and rows, the focused row's help, the keys along the
   bottom. KF1's colours: a near-black navy window, cream letters, one accent (the gold of the game's highlighted line);
   ember only for a key being listened for. Every word in the menu Cabin (libverdite/res/fonts). The chosen line lit
   by a glow fading in from the left; no bars or rounded boxes. Only borders, colours, straight gradients and images:
   the recorder draws no transforms, masks or filters (libverdite/src/ui_recorder.h). The logo and corners are alpha
   masks (tools/ui_masks.py), coloured here by image-color.

   Colours:  window #10121e to #07080e   sidebar #0d0f19 to #06070c   frame #545a7a / #262a3e   gold #e8cc8a
             text #e6e0cc   dim #8f8b9c   off #55536a   key #34384e   ember #d27a5a   corners #a88f5c */

/* (RmlUi has no default style sheet: every element is inline until it says otherwise) */
div, h1, h2, p, row, list, choice, tab {
	display: block;
}

/* (a flex box, so the window sits in the middle at any size: its auto margins would not, being sized by max-width) */
body {
	font-family: Cabin;
	font-size: 17dp;
	color: #e6e0cc;
	width: 100%;
	height: 100%;
	display: flex;
	justify-content: center;
	align-items: center;
}

#shade {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	decorator: vertical-gradient(#000000a0 #000000d4);
}

/* ---- The window ---------------------------------------------------------------------------------------------------- */
#window {
	position: relative;
	width: 92%;
	height: 90%;
	max-width: 1200dp; /* (shell.cpp fits this window to the screen) */
	max-height: 760dp;
}

#rule-outer {
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border: 2dp #545a7a;
	padding: 4dp;
	decorator: vertical-gradient(#10121ef4 #07080ef7);
}

#rule-inner {
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	border: 1dp #262a3e;
	border-top-color: #34384e;
	padding-bottom: 10dp;
	decorator: vertical-gradient(#ffffff08 #ffffff00);
}

/* the window's iron corners, over the frame */
img.corner {
	display: block;
	position: absolute;
	width: 64dp;
	height: 64dp;
	image-color: #a88f5c;
	pointer-events: none;
}

#corner-tl { left: -4dp; top: -4dp; }
#corner-tr { right: -4dp; top: -4dp; }
#corner-bl { left: -4dp; bottom: -4dp; }
#corner-br { right: -4dp; bottom: -4dp; }

/* ---- KF1's own window frame (body.game-art: the disc's status window, port/ui/game_window_art.h) ----------------------
   The game's gold frame in place of the rules and iron corners: 8 of the game's pixels thick at 2.5dp a pixel. Each edge
   is two halves, the second the first's mirror, so the pattern meets itself in the middle as the game's window does; the
   window's own shade shows through the frame's gaps, as the game's backdrop does. */
#game-frame {
	display: none;
}

/* (drawn over the window, so it lets the pointer through to the rows under it) */
body.game-art #game-frame {
	display: block;
	pointer-events: none;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

#game-frame div {
	position: absolute;
}

#frame-tl, #frame-tr, #frame-bl, #frame-br {
	width: 20dp;
	height: 20dp;
}

#frame-tl { left: 0; top: 0; decorator: image(game/frame-corner fill); }
#frame-tr { right: 0; top: 0; decorator: image(game/frame-corner flip-horizontal fill); }
#frame-bl { left: 0; bottom: 0; decorator: image(game/frame-corner flip-vertical fill); }
#frame-br { right: 0; bottom: 0; decorator: image(game/frame-corner rotate-180 fill); }

#frame-top-l, #frame-top-r, #frame-bottom-l, #frame-bottom-r {
	height: 20dp;
}

#frame-top-l { left: 20dp; right: 50%; top: 0; decorator: image(game/frame-top cover left top); }
#frame-top-r { left: 50%; right: 20dp; top: 0; decorator: image(game/frame-top flip-horizontal cover right top); }
#frame-bottom-l { left: 20dp; right: 50%; bottom: 0; decorator: image(game/frame-top flip-vertical cover left bottom); }
#frame-bottom-r { left: 50%; right: 20dp; bottom: 0; decorator: image(game/frame-top rotate-180 cover right bottom); }

#frame-left-t, #frame-left-b, #frame-right-t, #frame-right-b {
	width: 20dp;
}

#frame-left-t { top: 20dp; bottom: 50%; left: 0; decorator: image(game/frame-left cover left top); }
#frame-left-b { top: 50%; bottom: 20dp; left: 0; decorator: image(game/frame-left flip-vertical cover left bottom); }
#frame-right-t { top: 20dp; bottom: 50%; right: 0; decorator: image(game/frame-left flip-horizontal cover right top); }
#frame-right-b { top: 50%; bottom: 20dp; right: 0; decorator: image(game/frame-left rotate-180 cover right bottom); }

body.game-art #rule-outer {
	border-width: 0;
	padding: 20dp;
}

body.game-art #rule-inner {
	border-width: 0;
	decorator: none;
}

body.game-art img.corner {
	display: none;
}

#main {
	display: flex;
	flex-direction: row;
	flex: 1;
	min-height: 0;
}

/* ---- The sidebar: the logo, the pages, the version ----------------------------------------------------------------- */
#sidebar {
	display: flex;
	flex-direction: column;
	width: 250dp;
	box-sizing: border-box;
	padding: 24dp 0 12dp 0;
	border-right: 1dp #262a3e;
	decorator: vertical-gradient(#0d0f19c8 #06070cc8);
}

#crest {
	padding: 0 22dp 14dp 26dp;
	margin-bottom: 12dp;
	border-bottom: 1dp #262a3e;
}

/* "Verdite" and its 1, as Verdite2's wordmark sets its 2: the top of the letters */
#wordmark {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
}

#logo {
	width: 180dp;
	height: 48.4dp;
	image-color: #e6e0cc;
}

#logo-one {
	width: 7.6dp;
	height: 23.3dp;
	margin-left: 4.2dp;
	margin-top: 0.6dp;
	image-color: #e8cc8a;
}

#subtitle {
	font-size: 13dp;
	letter-spacing: 3dp;
	color: #8f8b9c;
	margin-top: 10dp;
}

#tabs {
	flex: 1;
	overflow-y: auto;
}

tab {
	font-size: 17dp;
	letter-spacing: 1dp;
	color: #8f8b9c;
	padding: 6dp 18dp 6dp 23dp;
	border-left: 3dp #00000000;
	cursor: pointer;
}

tab:hover {
	color: #e6e0cc;
}

tab.chosen {
	color: #f4eedc;
	border-left-color: #e8cc8a;
	decorator: horizontal-gradient(#e8cc8a2c #e8cc8a00);
}

#update {
	padding: 8dp 18dp 0 26dp;
}

#version {
	font-size: 12dp;
	color: #55536a;
	padding: 8dp 18dp 0 26dp;
}

/* ---- The page: its title and rows ---------------------------------------------------------------------------------- */
#content {
	display: flex;
	flex-direction: column;
	flex: 1;
	min-width: 0;
	padding: 20dp 12dp 0 26dp;
}

#heading {
	font-size: 28dp;
	letter-spacing: 2dp;
	color: #e8cc8a;
	padding-bottom: 4dp;
	margin-bottom: 16dp;
}

#page {
	flex: 1;
	overflow-y: auto;
	padding-right: 10dp;
}

row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	min-height: 34dp;
	padding: 2dp 12dp 2dp 15dp;
	border-left: 3dp #00000000;
	cursor: pointer;
}

row.heading {
	display: block;
	min-height: 0;
	line-height: 30dp;
	margin-top: 12dp;
	padding: 0 0 0 2dp;
	font-size: 15dp;
	letter-spacing: 1.5dp;
	color: #c8ae74;
	border-bottom: 1dp #262a3e;
	border-left: 0;
	margin-bottom: 4dp;
	cursor: auto;
}

row.status {
	cursor: auto;
}

row.focused {
	border-left-color: #e8cc8a;
	decorator: horizontal-gradient(#e8cc8a2c #e8cc8a00);
}

row.disabled {
	color: #55536a;
	cursor: auto;
}

label {
	display: block;
	flex: 1;
	min-width: 180dp;
}

value {
	display: block;
	color: #f4eedc;
	text-align: right;
	white-space: nowrap;
}

row.disabled value, row.status value {
	color: #8f8b9c;
}

row.action label {
	color: #e8cc8a;
}

/* the arrows either side of a choice's or a number's value */
arrow {
	display: inline-block;
	width: 20dp;
	text-align: center;
	color: #e8cc8a;
	cursor: pointer;
}

arrow:hover {
	color: #ffffff;
}

/* a number's place in its range */
bar {
	display: block;
	width: 110dp;
	height: 3dp;
	margin-left: 14dp;
	background-color: #262a3e;
}

fill {
	display: block;
	height: 100%;
	background-color: #e8cc8a;
}

note {
	display: block;
	width: 100%;
	font-size: 14dp;
	color: #8f8b9c;
	padding: 2dp 0 4dp 0;
}

/* an open choice's list, under its row */
list {
	margin: 0 12dp 6dp 40%;
	border: 1dp #545a7a;
	padding: 2dp;
	background-color: #07080ef8;
}

choice {
	padding: 4dp 12dp;
	border-left: 3dp #00000000;
	cursor: pointer;
}

choice.highlighted {
	decorator: horizontal-gradient(#e8cc8a2c #e8cc8a00);
}

choice.chosen {
	color: #e8cc8a;
}

/* ---- A command's controls ------------------------------------------------------------------------------------------ */
fixed, chip, slot {
	display: inline-block;
}

chip, slot {
	padding: 2dp 8dp;
	margin-left: 4dp;
	border: 1dp #262a3e;
	min-width: 28dp;
	text-align: center;
	font-size: 14dp;
}

chip {
	color: #8f8b9c;
}

slot {
	color: #c8c2ae;
	cursor: pointer;
}

slot:hover {
	border-color: #545a7a;
}

slot.chosen {
	color: #f4eedc;
	border-color: #e8cc8a;
	decorator: vertical-gradient(#2e2a1c #17150e);
}

slot.listening {
	color: #f0b49a;
	border-color: #d27a5a;
	decorator: vertical-gradient(#4a2418 #24110b);
}

add {
	color: #8f8b9c;
}

/* ---- The focused row's help ---------------------------------------------------------------------------------------- */
#help {
	width: 28%;
	max-width: 290dp;
	padding: 26dp 22dp 0 20dp;
	border-left: 1dp #262a3e;
	overflow-y: auto;
}

#help h2 {
	font-size: 19dp;
	color: #e8cc8a;
	padding-bottom: 6dp;
	border-bottom: 1dp #262a3e;
	margin-bottom: 10dp;
}

#help p {
	font-size: 15dp;
	line-height: 1.45;
	color: #c4beaa;
	margin-bottom: 8dp;
}

#help p.note {
	color: #8f8b9c;
}

/* ---- The keys along the bottom ------------------------------------------------------------------------------------- */
#prompts {
	text-align: center;
	font-size: 14dp;
	color: #8f8b9c;
	padding-top: 9dp;
	border-top: 1dp #262a3e;
}

prompt {
	display: inline-block;
	margin: 0 12dp;
}

key {
	display: inline-block;
	font-size: 13dp;
	padding: 0 6dp;
	margin-right: 5dp;
	border: 1dp #34384e;
	color: #e6e0cc;
}

/* ---- A narrow window or a phone: no help column, larger rows ------------------------------------------------------ */
body.touch #help {
	display: none;
}

body.touch row {
	min-height: 46dp;
}

body.touch tab {
	padding: 12dp 18dp 12dp 23dp;
}

body.touch #prompts {
	display: none;
}

/* ---- The first-run setup (body.setup: port/ui/setup_screen.cpp) ------------------------------------------------------
   The same window: the step in the sidebar in place of the pages, the page's title and its few words, its rows (the
   Welcome's cards, then Back, Next, Finish as buttons). */
body.setup #shade {
	background-color: #000000c8;
	decorator: none;
}

body.setup #help {
	max-width: 320dp;
}

#steps {
	padding: 0 18dp 0 26dp;
	color: #8f8b9c;
	font-size: 15dp;
	letter-spacing: 1dp;
}

body.setup #heading {
	font-size: 17dp;
	letter-spacing: 0;
	color: #e6e0cc;
	margin-bottom: 10dp;
}

#heading h1 {
	font-size: 28dp;
	letter-spacing: 2dp;
	color: #e8cc8a;
	margin-bottom: 10dp;
}

#heading p {
	font-size: 15dp;
	line-height: 1.4;
	color: #c4beaa;
	margin-bottom: 6dp;
}

#heading .dim, #heading p.prompt {
	color: #8f8b9c;
}

/* a welcome card: the preset's name, what it does, the display it picks */
row.card {
	display: block;
	border: 1dp #262a3e;
	border-left-width: 3dp;
	padding: 10dp 16dp;
	margin-bottom: 6dp;
}

row.card label {
	display: block;
	color: #e8cc8a;
	font-size: 20dp;
	letter-spacing: 1dp;
	margin-bottom: 4dp;
}

row.card.focused {
	border-color: #545a7a;
	border-left-color: #e8cc8a;
}

row.card note.dim {
	color: #6f6c80;
}

/* Back, Next, Finish, Skip: the last rows, as buttons */
row.way {
	display: inline-block;
	min-height: 0;
	margin: 14dp 10dp 0 0;
	padding: 6dp 22dp;
	border: 1dp #545a7a;
	color: #e8cc8a;
}

row.way label {
	min-width: 0;
	letter-spacing: 1dp;
}

row.way.focused {
	border-color: #e8cc8a;
}

body.touch row.card {
	padding: 14dp 18dp;
}

/* ---- The update notice (body.notice: port/ext/update_notice.cpp) and the menu's badge ------------------------------ */
#plate {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 580dp;
	margin-left: -290dp;
	margin-top: -150dp;
	box-sizing: border-box;
	border: 2dp #545a7a;
	padding: 4dp;
	decorator: vertical-gradient(#10121ef8 #07080efa);
}

#plate-inner {
	border: 1dp #262a3e;
	border-top-color: #34384e;
	padding: 22dp 26dp;
}

#plate #wordmark {
	margin-bottom: 16dp;
}

#plate h1 {
	color: #e8cc8a;
	font-size: 24dp;
	letter-spacing: 1.5dp;
	margin-bottom: 12dp;
}

#plate p {
	margin-bottom: 6dp;
}

#plate .dim {
	color: #8f8b9c;
}

#buttons {
	display: flex;
	flex-direction: row;
	margin-top: 18dp;
}

button {
	display: block;
	flex: 1;
	margin-right: 10dp;
	padding: 8dp 0;
	text-align: center;
	border: 1dp #545a7a;
	cursor: pointer;
}

button:hover, button.focused {
	border-color: #e8cc8a;
	color: #e8cc8a;
}

/* the main way on: the gold of Verdite's update buttons */
button#download {
	background-color: #d4b038;
	color: #14120a;
}

button#download.focused, button#download:hover {
	background-color: #e3cc7d;
	color: #14120a;
}

badge {
	display: inline-block;
	padding: 3dp 10dp;
	background-color: #d4b038;
	color: #14120a;
	font-size: 14dp;
	cursor: pointer;
}

/* ---- KF1's own pages of the F1 menu: Online, Console, About (port/ui/menu_page.h) --------------- */
.hidden, #help.hidden {
	display: none;
}

#part {
	padding: 0 12dp 0 18dp;
}

#part h2 {
	display: block;
	color: #e8cc8a;
	font-size: 20dp;
	margin-bottom: 4dp;
}

#part p {
	margin-bottom: 6dp;
}

#part .dim {
	color: #8f8b9c;
}

.page-text {
	margin: 6dp 0 12dp 0;
	max-width: 760dp;
}

input {
	display: block;
	width: 320dp;
	padding: 6dp 10dp;
	margin: 8dp 0;
	border: 1dp #545a7a;
	background-color: #07080e;
	color: #e6e0cc;
	cursor: text;
}

input:focus {
	border-color: #e8cc8a;
}

#console-lines {
	height: 380dp;
	overflow-y: auto;
	border: 1dp #262a3e;
	background-color: #08091480;
	padding: 6dp 10dp;
	font-size: 14dp;
	margin-bottom: 6dp;
}

p.line {
	margin: 0;
	white-space: pre-wrap;
	word-break: break-word;
}

p.line.error {
	color: #ff7466;
}

p.line.mods {
	color: #99ccff;
}

/* A scroll area's bar: RmlUi gives it no size of its own, so unstyled it covers the content. */
scrollbarvertical {
	width: 6dp;
	margin-left: 4dp;
}

scrollbarvertical slidertrack {
	background-color: #00000000;
}

scrollbarvertical sliderbar {
	background-color: #262a3e;
}

scrollbarvertical sliderbar:hover {
	background-color: #545a7a;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
	width: 0;
	height: 0;
}

scrollbarhorizontal {
	height: 6dp;
}

scrollbarhorizontal sliderbar {
	background-color: #262a3e;
}
