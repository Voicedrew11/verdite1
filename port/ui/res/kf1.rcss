/* The interface's look for King's Field: the game's own menus, a deep blue panel with a pale rule and
   cream letters, every word in the menu Mincho (libverdite/res/fonts). One accent, the gold of the
   game's highlighted line; ember only for a key being listened for. Only borders, colours, straight
   gradients and radii: the recorder draws no transforms, masks or filters (libverdite/src/ui_recorder.h).

   Colours:  panel #181a34 to #0c0d1c   sidebar #12142a   rule #6a6f9a / #2c2f52   gold #ffe6aa
             text #e8e2cc   dim #9a96a8   off #5c5a6c   key #2c2f52   ember #d27a5a */

/* (RmlUi has no default style sheet: every element is inline until it says otherwise) */
div, h2, p, row, list, choice, tab {
	display: block;
}

body {
	font-family: Mincho;
	font-size: 17dp;
	color: #e8e2cc;
	width: 100%;
	height: 100%;
}

#shade {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: #00000090;
}

#window {
	position: absolute;
	left: 5%;
	right: 5%;
	top: 6%;
	bottom: 6%;
	max-width: 1180dp;
	margin: 0 auto;
	border: 2dp #6a6f9a;
	border-radius: 6dp;
	padding: 3dp;
	decorator: vertical-gradient(#181a34f2 #0c0d1cf4);
	display: flex;
	flex-direction: column;
}

#main {
	flex: 1;
	display: flex;
	flex-direction: row;
	border: 1dp #2c2f52;
	border-radius: 4dp;
	min-height: 0;
}

/* ---- The pages ---------------------------------------------------------------------------------- */
#sidebar {
	width: 210dp;
	background-color: #12142acc;
	border-right: 1dp #2c2f52;
	padding: 18dp 0;
	display: flex;
	flex-direction: column;
}

#title {
	color: #ffe6aa;
	font-size: 22dp;
	letter-spacing: 2dp;
	padding: 0 22dp 14dp 22dp;
}

#tabs {
	flex: 1;
}

tab {
	padding: 7dp 22dp;
	color: #9a96a8;
	cursor: pointer;
}

tab:hover {
	color: #e8e2cc;
}

tab.chosen {
	color: #ffe6aa;
	decorator: horizontal-gradient(#ffe6aa30 #ffe6aa00);
}

#version {
	padding: 0 22dp;
	font-size: 13dp;
	color: #5c5a6c;
}

/* ---- The rows ----------------------------------------------------------------------------------- */
#content {
	flex: 1;
	overflow-y: auto;
	padding: 14dp 18dp;
	min-width: 0;
}

row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-items: center;
	padding: 6dp 12dp;
	border-radius: 3dp;
	cursor: pointer;
}

row.heading {
	color: #ffe6aa;
	font-size: 15dp;
	letter-spacing: 1.5dp;
	padding: 16dp 12dp 4dp 12dp;
	border-bottom: 1dp #2c2f52;
	margin-bottom: 4dp;
	cursor: auto;
}

row.status {
	cursor: auto;
}

row.focused {
	decorator: horizontal-gradient(#ffe6aa38 #ffe6aa08);
}

row.disabled {
	color: #5c5a6c;
	cursor: auto;
}

label {
	flex: 1;
	min-width: 180dp;
}

value {
	color: #ffe6aa;
	min-width: 140dp;
	text-align: right;
}

row.disabled value, row.status value {
	color: #9a96a8;
}

row.action label {
	color: #ffe6aa;
}

arrow {
	color: #ffe6aa;
	padding: 0 8dp;
	cursor: pointer;
}

bar {
	display: block;
	width: 120dp;
	height: 5dp;
	margin-left: 12dp;
	background-color: #2c2f52;
	border-radius: 2dp;
}

fill {
	display: block;
	height: 100%;
	background-color: #ffe6aa;
	border-radius: 2dp;
}

note {
	display: block;
	width: 100%;
	font-size: 14dp;
	color: #9a96a8;
	padding-top: 2dp;
}

/* an open choice's list, under its row */
list {
	margin: 2dp 12dp 8dp 40%;
	border: 1dp #6a6f9a;
	border-radius: 3dp;
	background-color: #0c0d1cf6;
	padding: 4dp 0;
}

choice {
	padding: 4dp 14dp;
	cursor: pointer;
}

choice.highlighted {
	decorator: horizontal-gradient(#ffe6aa38 #ffe6aa08);
}

choice.chosen {
	color: #ffe6aa;
}

/* ---- A command's controls ----------------------------------------------------------------------- */
fixed, chip, slot {
	display: inline-block;
}

chip, slot {
	padding: 2dp 10dp;
	margin-left: 6dp;
	border: 1dp #2c2f52;
	border-radius: 3dp;
	background-color: #12142a;
	min-width: 28dp;
	text-align: center;
}

chip {
	color: #9a96a8;
}

slot {
	cursor: pointer;
}

slot.chosen {
	border-color: #ffe6aa;
}

slot.listening {
	border-color: #d27a5a;
	color: #d27a5a;
}

add {
	color: #9a96a8;
}

/* ---- The focused row's help --------------------------------------------------------------------- */
#help {
	width: 300dp;
	border-left: 1dp #2c2f52;
	padding: 22dp 22dp;
	color: #c8c2ac;
	font-size: 15dp;
}

#help h2 {
	color: #ffe6aa;
	font-size: 18dp;
	margin-bottom: 10dp;
}

#help p {
	margin-bottom: 8dp;
}

#help p.note {
	color: #9a96a8;
}

/* ---- The keys along the bottom ------------------------------------------------------------------ */
#prompts {
	padding: 8dp 14dp 4dp 14dp;
	font-size: 14dp;
	color: #9a96a8;
	text-align: right;
}

prompt {
	margin-left: 18dp;
}

key {
	padding: 0 6dp;
	margin-right: 4dp;
	border: 1dp #2c2f52;
	border-radius: 3dp;
	background-color: #12142a;
	color: #e8e2cc;
}

/* ---- A narrow window or a phone: no help column, larger rows ------------------------------------ */
body.touch #help {
	display: none;
}

body.touch row {
	padding: 12dp 14dp;
}

body.touch tab {
	padding: 12dp 22dp;
}

body.touch #prompts {
	display: none;
}

/* ---- The first-run setup (body.setup: port/ui/setup_screen.cpp) --------------------------------- */
body.setup #shade {
	background-color: #000000c8;
}

#steps {
	padding: 0 22dp;
	color: #9a96a8;
	font-size: 15dp;
}

#heading {
	padding: 4dp 12dp 14dp 12dp;
}

#heading h1 {
	display: block;
	color: #ffe6aa;
	font-size: 26dp;
	letter-spacing: 1.5dp;
	margin-bottom: 10dp;
}

#heading p {
	margin-bottom: 8dp;
}

#heading .dim, #heading p.prompt {
	color: #9a96a8;
}

/* a welcome card: the preset's name, what it does, the display it picks */
row.card {
	display: block;
	border: 1dp #2c2f52;
	border-radius: 4dp;
	padding: 12dp 16dp;
	margin-bottom: 8dp;
	background-color: #12142a;
}

row.card label {
	display: block;
	color: #ffe6aa;
	font-size: 19dp;
	margin-bottom: 4dp;
}

row.card.focused {
	border-color: #ffe6aa;
}

row.card note.dim {
	color: #5c5a6c;
}

/* Back, Next, Finish, Skip: the last rows, as buttons */
row.way {
	display: inline-block;
	margin: 14dp 10dp 0 0;
	padding: 6dp 22dp;
	border: 1dp #6a6f9a;
	border-radius: 3dp;
	color: #ffe6aa;
}

row.way label {
	min-width: 0;
}

row.way.focused {
	border-color: #ffe6aa;
}

body.touch row.card {
	padding: 16dp 18dp;
}

/* ---- The update notice (body.notice: port/ext/update_notice.cpp) and the menu's badge ------------ */
#plate {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 560dp;
	margin-left: -280dp;
	margin-top: -110dp;
	padding: 22dp 26dp;
	border: 2dp #6a6f9a;
	border-radius: 6dp;
	decorator: vertical-gradient(#181a34f6 #0c0d1cf8);
}

#plate h1 {
	display: block;
	color: #ffe6aa;
	font-size: 24dp;
	margin-bottom: 12dp;
}

#plate p {
	margin-bottom: 6dp;
}

#plate .dim {
	color: #9a96a8;
}

#buttons {
	display: flex;
	flex-direction: row;
	margin-top: 18dp;
}

button {
	display: block;
	flex: 1;
	margin-right: 10dp;
	padding: 8dp 0;
	text-align: center;
	border: 1dp #6a6f9a;
	border-radius: 3dp;
	cursor: pointer;
}

button:hover, button.focused {
	border-color: #ffe6aa;
	color: #ffe6aa;
}

/* the main way on: the gold of Verdite's update buttons */
button#download {
	background-color: #d4b038;
	color: #14120a;
}

button#download.focused, button#download:hover {
	background-color: #e3cc7d;
	color: #14120a;
}

#update {
	padding: 0 22dp 10dp 22dp;
}

badge {
	display: inline-block;
	padding: 3dp 10dp;
	border-radius: 3dp;
	background-color: #d4b038;
	color: #14120a;
	font-size: 14dp;
	cursor: pointer;
}
