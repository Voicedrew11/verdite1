// The Verdite online service (online/protocol/PROTOCOL.md). Secrets, never in the repo:
// TURN_KEY_ID and TURN_KEY_API_TOKEN, set with wrangler secret put (online/README.md, "Secrets").
{
  "name": "verdite-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // served at verdite-online.<account>.workers.dev; no per-version preview addresses
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
