// The Verdite online service (online/protocol/PROTOCOL.md). Secrets, never in the repo, set with
// wrangler secret put (online/README.md, "Secrets"): TURN_KEY_ID, TURN_KEY_API_TOKEN, and for the
// budget CF_ACCOUNT_ID and CF_ANALYTICS_TOKEN.
{
  "name": "verdite-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // served at verdite-online.<account>.workers.dev; no per-version preview addresses
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Budget"] }
  ],
  // per address, per Cloudflare location, approximate
  "ratelimits": [
    { "name": "JOIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "TURN_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // the month's TURN egress (what Cloudflare bills) above which no credentials are issued
  "vars": { "TURN_BUDGET_GB": "500" },
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
