{
  // King's Field (JP, SLPS-00017) -- the first game. From Software, 1994.
  // Config schema: tools/RecompOne/RecompOne.Recompiler/Config/ConfigLoader.cs
  // JSON comments and trailing commas are accepted by the loader.
  //
  // NUMBER BASES DIFFER between this file and the CLI:
  //   here : "base" is a hex STRING; "size"/"skip"/"offset"/"lba" are decimal numbers.
  //   CLI  : -size/-skip/-offset are HEX; -lba is decimal.
  //
  // See docs/KF1.md for how every address below was identified.
  "game": {
    "id": "SLPS-00017",
    "name": "KingsField",
    "output": "../generated"
  },

  "cue": "../disc/King's Field (Japan).cue",

  // The disc has no SYSTEM.CNF, so the BIOS boots its default, cdrom:PSX.EXE --
  // a 2 KiB loader at 0x80010000 that Execs OPEN.EXE as a call and then
  // GAME.EXE, forever (the pointer pair at 0x80010224). RecompOne's SystemCfg
  // falls back to the same default.
  "funcMap": "funcmaps/kf1/psx.json",

  // OPEN.EXE and GAME.EXE both load at 0x80012000 and are mutually exclusive.
  // There is no END.EXE and no area code modules: all of KF1's per-area logic
  // is inside GAME.EXE. Overlays are read as raw bytes, so "skip": 2048 steps
  // the PS-X EXE header, and "base" is the header's text address.
  "overlays": [
    {
      "name": "open",
      "file": "OPEN.EXE",
      "base": "0x80012000",
      "skip": 2048,
      "funcMap": "funcmaps/kf1/open.json",
      "functions": [
        { "address": "0x8001AA7C", "name": "open_entry" }
      ]
    },
    {
      "name": "game",
      "file": "GAME.EXE",
      "base": "0x80012000",
      "skip": 2048,
      "funcMap": "funcmaps/kf1/game.json",
      "functions": [
        { "address": "0x8003AC5C", "name": "game_entry" }
      ]
    }
  ],

  "stubs": [],
  "ignored": [],

  // SDK entry points bound to the runtime's HLE by address. The function maps
  // carry upstream's signature names for everything else, but every name
  // SdkPatches would bind is kept func_-named (as in the KF2 port), so the
  // binding is exactly this list. libcd, libcdstream and three of libgpu were
  // found by the signature bank; VSync, PutDispEnv and DMACallback are the 1994
  // library's own shapes, which the bank does not hold (docs/KF1.md, "The SDK
  // entry points").
  "patches": [
    // libetc VSync: the 1994 vsync.c waits on a root-counter event, not RCNT1
    { "overlay": "open", "address": "0x800352C4",
      "target": "RecompOne.Runtime.Sdk.LibEtc.VSync", "mode": "replace" },
    { "overlay": "game", "address": "0x800555E0",
      "target": "RecompOne.Runtime.Sdk.LibEtc.VSync", "mode": "replace" },

    // libcd
    { "overlay": "open", "address": "0x8001C390",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdInit", "mode": "replace" },
    { "overlay": "game", "address": "0x8003C570",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdInit", "mode": "replace" },
    { "overlay": "open", "address": "0x8001ACF8",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControl", "mode": "replace" },
    { "overlay": "open", "address": "0x8001AD5C",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlF", "mode": "replace" },
    { "overlay": "open", "address": "0x8001ADB8",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlB", "mode": "replace" },
    { "overlay": "open", "address": "0x8001AB34",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdSync", "mode": "replace" },
    { "overlay": "game", "address": "0x8003AED8",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControl", "mode": "replace" },
    { "overlay": "game", "address": "0x8003AF3C",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlF", "mode": "replace" },
    { "overlay": "game", "address": "0x8003AF98",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdControlB", "mode": "replace" },
    { "overlay": "game", "address": "0x8003AD14",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdSync", "mode": "replace" },
    { "overlay": "open", "address": "0x8001AE54",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdRead", "mode": "replace" },
    { "overlay": "game", "address": "0x8003B034",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdRead", "mode": "replace" },
    { "overlay": "open", "address": "0x8001AB54",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdReady", "mode": "replace" },
    { "overlay": "open", "address": "0x8001AE34",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdGetSector", "mode": "replace" },
    { "overlay": "game", "address": "0x8003AD34",
      "target": "RecompOne.Runtime.Sdk.LibCd.CdReady", "mode": "replace" },
    { "overlay": "game", "address": "0x8003B014",
