    // libapi DMACallback: the 1994 one returns nothing; the HLE's V0 is harmless
    { "overlay": "open", "address": "0x8002FA00",
      "target": "RecompOne.Runtime.Sdk.LibApi.DMACallback", "mode": "replace" },
    { "overlay": "game", "address": "0x8004FC2C",
      "target": "RecompOne.Runtime.Sdk.LibApi.DMACallback", "mode": "replace" }
  ],

  "debug": false,
